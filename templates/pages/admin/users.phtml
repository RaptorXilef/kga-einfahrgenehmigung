 *
 * Container für die Benutzer- und Rechte-Matrix.
 *
 * Verwaltungsoberfläche für Systembenutzer, Gruppen und Rechte.
 * Bietet Masken für Passwörtrücksetzungen, Gruppen-Rechte-Zuweisungen (Matrix) sowie Avatar-/Icon-Uploads.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var array $roles Liste aller Berechtigungsgruppen samt zugeordneter Roh-Rechte.
 * @var array $settings
 * @var array $users Vollständige Liste aller registrierten Benutzerkonten im System.
 * @var string $appRoot
 */
$layout = 'admin';
$pageTitle = 'Benutzer & Rechte - ' . ($settings['vereins_name'] ?? '');

if ($auth->hasPermission('system.manage')) { ?>
    <main class="c-tab-content-container u-padding-y-l">
        <?php require $appRoot . '/templates/partials/frontend/alerts.phtml'; ?>

        <div class="c-tabs">
            <div class="c-tabs__nav u-margin-bottom-l">
                <?php if ($auth->hasPermission('system.users.manage')) { ?>
                    <button class="c-tabs__btn c-tabs__btn--active"
                            data-tab-target="tab-users">
                        <img src="<?php echo $asset->url('assets/img/icons/icon-user.webp'); ?>"
                             class="c-icon"
                             alt=""> Benutzerverwaltung
                    </button>
                <?php } ?>
                <?php if ($auth->hasPermission('system.roles.manage')) { ?>
                    <button class="c-tabs__btn"
                            data-tab-target="tab-roles">
                        <img src="<?php echo $asset->url('assets/img/icons/icon-shield.webp'); ?>"
                             class="c-icon"
                             alt=""> Rollen & Rechte
                    </button>
                <?php } ?>
            </div>

            <?php if ($auth->hasPermission('system.users.manage')) { ?>
                <div id="tab-users"
                     class="c-tabs__content c-tabs__content--active">
                    <?php include $appRoot . '/templates/partials/admin/tab_users.phtml'; ?>
                </div>
            <?php } ?>
            <?php if ($auth->hasPermission('system.roles.manage')) { ?>
                <div id="tab-roles"
                     class="c-tabs__content">
                    <?php include $appRoot . '/templates/partials/admin/tab_roles.phtml'; ?>
                </div>
            <?php } ?>
        </div>
    </main>

    <script>
    function updateUiMode(mode) {
        const wrappers = document.querySelectorAll('.p-tree-wrapper');
        wrappers.forEach(w => {
            w.classList.remove('mode-hide', 'mode-grey');
            w.classList.add('mode-' + mode);
        });
        localStorage.setItem('pref_perm_ui_mode', mode);
    }

    function applyMasterState(container, isMaster) {
        const treeWrapper = container.querySelector('.p-tree-wrapper');
        if (!treeWrapper) return;
        if (isMaster) {
            treeWrapper.classList.add('is-master-active');
            treeWrapper.querySelectorAll('input[data-perm-check]').forEach(cb => {
                cb.disabled = true;
                cb.parentElement.style.opacity = "0.5";
                cb.parentElement.style.pointerEvents = "none";
            });
        } else {
            treeWrapper.classList.remove('is-master-active');
            treeWrapper.querySelectorAll('input[data-perm-check]').forEach(cb => {
                cb.disabled = false;
                cb.parentElement.style.opacity = "1";
                cb.parentElement.style.pointerEvents = "auto";
            });
        }
    }

    function refreshTreeVisually(container) {
        const nodes = container.querySelectorAll('.p-tree-node');
        nodes.forEach(node => {
            const key = node.dataset.key;
            if (!key) return;
            const parentNode = node.parentElement.closest('.p-tree-node');
            if (parentNode) {
                const parentCheckbox = parentNode.querySelector(':scope > .p-item input[data-perm-check]');
                if (parentCheckbox && !parentCheckbox.checked) {
                    node.classList.add('is-locked');
                } else {
                    node.classList.remove('is-locked');
                }
            }
        });
    }

    /**
     * Fokus-Logik: Springt zum editierten User/Gruppe
     */
    function handleUrlFocus() {
        const urlParams = new window.URLSearchParams(window.location.search); // TODO JS Datei "window." entfernen
        const focusId = urlParams.get('focus');

        if (focusId) {
            // 1. Karte im gesamten Dokument suchen
            const targetCard = document.getElementById('card-' + focusId);

            if (targetCard) {
                // 2. Intelligenten Tab-Wechsel durchführen
                const parentTabContent = targetCard.closest('.c-tabs__content');
                if (parentTabContent) {
                    const tabBtn = document.querySelector(`[data-tab-target="${parentTabContent.id}"]`);
                    if (tabBtn) {
                        // Alle Tabs deaktivieren
                        document.querySelectorAll('.c-tabs__btn').forEach(b => b.classList.remove(
                            'c-tabs__btn--active'));
                        document.querySelectorAll('.c-tabs__content').forEach(c => c.classList.remove(
                            'c-tabs__content--active'));

                        // Ziel-Tab aktivieren
                        tabBtn.classList.add('c-tabs__btn--active');
                        parentTabContent.classList.add('c-tabs__content--active');
                    }
                }

                // 3. Karte aufklappen und hinklettern
                setTimeout(() => {
                    targetCard.classList.remove('is-closed');
                    targetCard.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });

                    // Visuelles Feedback (Ring-Leuchten)
                    targetCard.style.outline = "3px solid var(--primary-color)";
                    targetCard.style.outlineOffset = "2px";
                    setTimeout(() => {
                        targetCard.style.outline = "none";
                    }, 2000);
                }, 400);
            }
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // A. UI Modus (Fokus/Experte) wiederherstellen
        const savedMode = localStorage.getItem('pref_perm_ui_mode') || 'hide';
        updateUiMode(savedMode);
        const radio = document.querySelector(`input[name="ui_mode_toggle"][value="${savedMode}"]`);
        if (radio) radio.checked = true;

        // B. Initialen Zustand der Matrizen (Master/Locks) berechnen
        document.querySelectorAll('.permission-container').forEach(container => {
            const masterCb = container.querySelector('input[data-master-toggle]');
            if (masterCb) applyMasterState(container, masterCb.checked);
            refreshTreeVisually(container);
        });

        // C. Fokus-Sprung ausführen
        handleUrlFocus();
    });

    document.addEventListener('change', function(e) {
        // 1. MASTER TOGGLE Logik
        if (e.target && e.target.dataset.masterToggle) {
            applyMasterState(e.target.closest('.permission-container'), e.target.checked);
        }

        // 2. SMART TREE Logik
        if (e.target && e.target.dataset.permCheck) {
            const checkbox = e.target;
            const container = checkbox.closest('.permission-container');
            if (checkbox.checked) {
                // Bottom-Up Aktivierung
                let parentNode = checkbox.closest('.p-tree-node').parentElement.closest('.p-tree-node');
                while (parentNode) {
                    const parentCheckbox = parentNode.querySelector(':scope > .p-item input[data-perm-check]');
                    if (parentCheckbox && !parentCheckbox.checked) {
                        parentCheckbox.checked = true;
                        parentCheckbox.closest('.p-item').classList.add('is-auto-active');
                        setTimeout(() => {
                            if (parentCheckbox.closest('.p-item')) parentCheckbox.closest('.p-item')
                                .classList.remove('is-auto-active');
                        }, 1000);
                    }
                    parentNode = parentNode.parentElement.closest('.p-tree-node');
                }
            } else {
                // Top-Down Deaktivierung
                checkbox.closest('.p-tree-node').querySelectorAll('input[data-perm-check]').forEach(child =>
                    child.checked = false);
            }
            refreshTreeVisually(container);
        }
    });

    </script>
<?php } ?>
