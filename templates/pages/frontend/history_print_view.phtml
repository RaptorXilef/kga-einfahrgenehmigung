<?php

use App\Contracts\Config\ConfigInterface;
use App\Contracts\System\AssetHelperInterface;
use App\Core\Entity\Permit;

/**
 * Page: Print Preview (History)
 *
 * Druckansicht einer Genehmigung für den User.
 * Generiert ein optimiertes A4-Layout einer einzelnen Genehmigung direkt aus dem Dashboard heraus.
 *
 * @var AssetHelperInterface $asset
 * @var ConfigInterface $config   Globale System-Konfiguration.
 * @var Permit $permit   Die zu druckende Genehmigungs-Entität.
 * @var array $settings Einstellungen für das Layout (z.B. jahresFarbe).
 * @var array|string $opening  Formatierter Text der allgemeinen Öffnungszeiten.
 * @var string $appRoot  Absoluter Pfad zum Root-Verzeichnis.
 * @var string $cspNonce
 */
?>
<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <title>Druckvorschau - <?php echo \htmlspecialchars($permit->code); ?></title>
    <?php include_once $appRoot . '/templates/partials/frontend/favicon.phtml'; ?>
    <link rel="stylesheet"
          href="<?php echo $asset->url('assets/css/main.min.css'); ?>">
    <script nonce="<?php echo $cspNonce; ?>">
    window.KGA_CONFIG = {
        baseUrl: '<?php echo \htmlspecialchars($settings['base_url'] ?? '', \ENT_QUOTES, 'UTF-8'); ?>',
        csrfToken: '<?php echo \htmlspecialchars($_SESSION['csrf_token'] ?? '', \ENT_QUOTES, 'UTF-8'); ?>'
    };

    </script>
    <style>
    body {
        background: #f1f5f9;
    }

    @media print {
        .u-no-print {
            display: none !important;
        }

        body {
            background: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }
    }

    .print-toolbar {
        background: #1e293b;
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .c-button--primary,
    .c-button--secondary {
        color: #fff;
        border: none;
        padding: 14px 24px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.2s, background 0.2s;
        display: block;
        margin: 0 auto;
    }

    .c-button--primary {
        background: var(--primary-color);
    }

    .c-button--secondary {
        background: var(--primary-color);
    }

    .c-button--primary:hover,
    .c-button--secondary:hover {
        background: #2980b9;
        transform: translateY(-1px);
    }

    .c-icon {
        display: inline-block;
        width: 1em;
        height: 1em;
        vertical-align: middle;
        margin-top: -2px;
        object-fit: contain;
    }

    .c-button .c-icon {
        width: 2.2em;
        height: 2.2em;
        margin: 0;
    }

    .c-tabs__btn .c-icon {
        width: 1.4em;
        height: 1.4em;
        margin-right: 4px;
    }

    </style>
</head>

<body>
    <div class="print-toolbar u-no-print">
        <button type="button"
                class="c-button c-button--secondary js-close-window">✕ Druckansicht schließen</button>
        <div class="u-font-bold">Druckvorschau: <?php echo \htmlspecialchars($permit->code); ?></div>
        <button type="button"
                class="c-button c-button--primary js-print-window">
            <img src="<?php echo $asset->url('assets/img/icons/action-print.webp'); ?>"
                 class="c-icon"
                 alt="Drucken"> Dokument jetzt drucken
        </button>
    </div>
    <?php
    // WICHTIG: Wir übergeben hier die DateTime-Objekte direkt ($permit->getValidFrom()),
    // damit das A4-Template die Quartale berechnen kann!
    $data = [
        'fullIdentifier' => $permit->code,
        'von_formatted' => $permit->getValidFrom()->format('d.m.Y'),
        'bis_formatted' => $permit->getValidUntil()->format('d.m.Y'),
        'kennzeichen' => $permit->getLicensePlate(),
        'firma' => $permit->getCompany() ?? '',
        'parzelle' => $permit->getPlotNumber(),
        'zweck' => $permit->getPurpose(),
        'template_key' => $permit->template_key,
        'vereinsName' => $settings['vereins_name'],
        'jahresFarbe' => $settings['jahresFarbe'],
        'opening_html' => $opening_html ?? '',
        'holidayNotice' => $holidayNotice ?? '',
        'terminkalenderUrl' => $settings['terminkalender_url'],
        'erstellt' => $permit->getCreatedAt()->format('d.m.Y H:i'),
        'checkUrl' => $settings['base_url'] . 'check?code=' . $permit->code,
        'config' => $config,
    ];

// Variablen in den lokalen Scope extrahieren
// TODO Prüfen ob lieber ohne EXTR_SKIP
\extract($data, \EXTR_SKIP);
include $appRoot . '/templates/emails/permit_a4_document.phtml';
?>
    <!-- CSP konformes Event JS -->
    <script type="module"
            src="<?php echo $asset->url('assets/js/app.js'); ?>"
            nonce="<?php echo $cspNonce; ?>"></script>
</body>

</html>
