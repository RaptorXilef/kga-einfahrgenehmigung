<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Entity\Permit;
use App\Core\Entity\PermitStatus;
use App\Core\Service\AuthService;
use App\Infrastructure\Config\Config;

/**
 * Page: Verification Details (Admin View)
 *
 * Erweiterte Prüfseite für Schrankenpersonal und Vorstand.
 *
 * Erweiterte administrative Kontrollansicht für Platzwarte und Vorstände.
 * Zeigt neben dem Gültigkeitsstatus auch sensible Daten wie Pächtername, Parzelle,
 * interne Kommentare sowie administrative Schnell-Aktionen (z.B. Sperren/Drucken).
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var Permit|null $permit        Die gefundene Genehmigungs-Entität.
 * @var array $settings
 * @var bool $isDateValid   Ob das Ticket im Datumsbereich liegt.
 * @var bool $isTimeAllowed Ob laut HolidayService jetzt geöffnet ist.
 * @var string $allowedToday  Nächster regulärer Einfahrts-Slot als Text.
 * @var string $appRoot
 */

// Status-Farbe bestimmen und dem Layout übergeben
$pageStateClass = 'state-bg-error'; // Default: Rot
if ($permit) {
    if ($permit->isSuspended()) {
        $pageStateClass = 'state-bg-error';
    } elseif ($isDateValid && $isTimeAllowed) {
        $pageStateClass = 'state-bg-valid'; // Grün
    } elseif ($isDateValid && !$isTimeAllowed) {
        $pageStateClass = 'state-bg-rest'; // Gelb/Orange
    }
}

$layout = 'admin';
$pageTitle = 'Vorstands-Prüfung - ' . ($permit ? $permit->code : 'Fehler');
?>

<main class="c-tab-content-container u-padding-y-l">

    <!-- GROSSER STATUS-BANNER (Synchron zur öffentlichen Ansicht) -->
    <div class="c-box u-margin-bottom-l u-text-center">
        <?php if ($permit && $permit->isSuspended()) { ?>
            <div class="u-color-danger">
                <img src="<?php echo $asset->url('assets/img/icons/status-denied.webp'); ?>"
                     class="c-icon c-icon--lg"
                     alt="">
                <h2 class="u-color-danger u-margin-top-s u-margin-bottom-xs">ZUTRITT VERWEIGERT</h2>
                <p class="u-font-semibold u-margin-none">Diese Genehmigung ist gesperrt/widerrufen.</p>
            </div>
        <?php } elseif ($permit && $isDateValid && $isTimeAllowed) { ?>
            <div class="u-color-success">
                <img src="<?php echo $asset->url('assets/img/icons/status-success.webp'); ?>"
                     class="c-icon c-icon--lg"
                     alt="">
                <h2 class="u-color-success-dark u-margin-top-s u-margin-bottom-none">GENEHMIGUNG GÜLTIG</h2>
            </div>
        <?php } elseif ($permit && $isDateValid && !$isTimeAllowed) { ?>
            <div class="u-color-warning">
                <span class="u-text-4xl">⏳</span>
                <h2 class="u-color-warning u-margin-top-s">AKTUELL RUHEZEIT</h2>
                <?php if (\str_contains($allowedToday, 'Gültigkeit')) { ?>
                    <!-- Sonderfall: Genehmigung läuft während der Ruhezeit ab -->
                    <p class="u-margin-none u-font-semibold"><?php echo $allowedToday; ?></p>
                <?php } else { ?>
                    <!-- Normalfall: Nächste Zeit anzeigen -->
                    <p class="u-margin-none">Nächste Einfahrt möglich: <strong class="u-font-semibold"><?php echo $allowedToday; ?></strong>
                    </p>
                <?php } ?>
            </div>
        <?php } else { ?>
            <div class="u-color-muted">
                <img src="<?php echo $asset->url('assets/img/icons/status-invalid.webp'); ?>"
                     class="c-icon c-icon--lg"
                     alt="">
                <h2 class="u-margin-top-s u-margin-bottom-none">GENEHMIGUNG UNGÜLTIG</h2>
            </div>
        <?php } ?>
    </div>

    <header class="u-flex u-justify-between u-align-center u-margin-bottom-l">
        <div>
            <h1 class="u-margin-none u-text-left">Detailprüfung (Vorstand)</h1>
            <p class="u-color-muted">Interne Daten für Code: <code><?php echo $permit ? $permit->code : '---'; ?></code></p>
        </div>
        <div class="u-flex u-gap-s">
            <a href="check" class="c-button c-button--secondary">
                <img src="<?php echo $asset->url('assets/img/icons/action-search.webp'); ?>" class="c-icon" alt=""> Neue Prüfung
            </a>
            <?php if ($permit && $auth->hasPermission('permits.print')) { ?>
                <a href="admin_print?code=<?php echo $permit->code; ?>" target="_blank" class="c-button c-button--primary">
                    <img src="<?php echo $asset->url('assets/img/icons/action-print.webp'); ?>" class="c-icon" alt=""> Drucken
                </a>
            <?php } ?>
        </div>
    </header>

    <?php if ($permit) { ?>
        <section class="c-card c-card--primary">
            <header class="c-card__header u-flex u-justify-between u-align-center">
                <h3 class="u-margin-none">📋 Pächter- & Fahrzeugdaten</h3>
                <span class="c-badge c-badge--<?php echo $permit->getStatus() === PermitStatus::Bezahlt ? 'success' : 'warning'; ?>">
                    FINANZ-STATUS: <?php echo \htmlspecialchars(\strtoupper($permit->getStatus()->value)); ?>
                </span>
            </header>

            <div class="c-card__body u-padding-none">
                <table class="c-table">
                    <?php if ($permit->isSuspended() && !empty($permit->getSuspensionReason())) { ?>
                        <tr class="c-table__row c-table__row--danger">
                            <td class="c-table__label u-font-bold u-color-danger">Sperrgrund</td>
                            <td class="c-table__value u-color-danger"><?php echo \htmlspecialchars($permit->getSuspensionReason()); ?></td>
                        </tr>
                    <?php } ?>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold"
                            style="width: 35%;">Pächter Name</td>
                        <td class="c-table__value"><?php echo \htmlspecialchars($permit->getOwnerName()); ?></td>
                    </tr>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Parzelle</td>
                        <td class="c-table__value">Nr. <?php echo \htmlspecialchars($permit->getPlotNumber()); ?></td>
                    </tr>
                    <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                        <tr class="c-table__row">
                            <td class="c-table__label u-font-bold">E-Mail</td>
                            <td class="c-table__value">
                                <?php echo $permit->getOwnerEmail()
                                    ? '<a href="mailto:' . \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8') . '" class="u-text-link">' . \str_replace('@', '<wbr>@<wbr>', \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8')) . '</a>'
                                    : '<em class="u-color-muted">Keine E-Mail hinterlegt</em>';
                        ?>
                            </td>
                        </tr>
                    <?php } ?>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Zweck / Grund</td>
                        <td class="c-table__value"><?php echo \htmlspecialchars($permit->getPurpose()); ?></td>
                    </tr>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Fahrzeugtyp</td>
                        <td class="c-table__value"><?php echo \strtoupper($permit->getVehicleType()); ?></td>
                    </tr>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Kennzeichen</td>
                        <td class="c-table__value c-table__value--code"><?php echo \htmlspecialchars($permit->getLicensePlate()); ?></td>
                    </tr>
                    <?php if ($permit->getCompany()) { ?>
                        <tr class="c-table__row">
                            <td class="c-table__label u-font-bold">Firma / Lieferant</td>
                            <td class="c-table__value"><?php echo \htmlspecialchars($permit->getCompany()); ?></td>
                        </tr>
                    <?php } ?>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Zeitraum</td>
                        <td class="c-table__value"><?php echo $permit->getValidFrom()->format('d.m.Y'); ?> bis <?php echo $permit->getValidUntil()->format('d.m.Y'); ?></td>
                    </tr>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">Erlaubte Zeiten</td>
                        <td class="c-table__value"><?php echo $opening ?? ''; ?></td>
                    </tr>
                    <?php if (!empty($holidayNotice)) { ?>
                        <tr class="c-table__row c-table__row--warning">
                            <td class="c-table__label u-font-bold u-color-danger">Enthaltene Ruhe- und Feiertage</td>
                            <td class="c-table__value u-color-danger"><?php echo $holidayNotice; ?></td>
                        </tr>
                    <?php } ?>
                    <?php if ($auth->hasPermission('privacy.finance.view')) { ?>
                        <tr class="c-table__row">
                            <td class="c-table__label u-font-bold">Gebühr (Snapshot)</td>
                            <td class="c-table__value"><?php echo \number_format($permit->getPrice(), 2, ',', '.'); ?> €</td>
                        </tr>
                    <?php } ?>
                    <tr class="c-table__row">
                        <td class="c-table__label u-font-bold">System-Erstellung</td>
                        <td class="c-table__value"><?php echo $permit->getCreatedAt()->format('d.m.Y H:i'); ?> Uhr</td>
                    </tr>
                </table>
            </div>

            <!-- MANUELLE FREISCHALTUNG -->
            <?php if ($auth->hasPermission('finance.mark_paid')) { ?>
                <?php if ($permit->getStatus() !== PermitStatus::Bezahlt) { ?>
                    <footer class="c-card__footer u-text-center">
                        <form method="POST"
                              action="<?php echo $settings['base_url']; ?>mark_as_paid"
                              class="u-flex u-justify-center u-margin-none"
                              data-confirm="Sind Sie sicher, dass Sie den Status auf Bezahlt ändern möchten?">
                            <input type="hidden"
                                   name="csrf_token"
                                   value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>">
                            <input type="hidden"
                                   name="code"
                                   value="<?php echo $permit->code; ?>">
                            <button type="submit"
                                    class="c-button c-button--success c-button--large o-container o-container--small">
                                ✔ Zahlung erhalten, jetzt freischalten
                            </button>
                        </form>
                    </footer>
                <?php } ?>
            <?php } ?>
        </section>
    <?php } ?>
</main>
