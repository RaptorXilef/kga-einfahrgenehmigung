<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Entity\Permit;
use App\Infrastructure\Config\Config;

/**
 * Page: Public View (Check)
 *
 * Öffentliche Kontrollansicht (z.B. bei QR-Code-Scan durch externe Personen oder Wachpersonal).
 * Zeigt reduzierte, datenschutzkonforme Status-Informationen einer Genehmigung an.
 *
 * @var AssetHelperInterface $asset
 * @var Config $config Anwendungs-Konfiguration.
 * @var Permit $permit Die gefundene Genehmigungs-Entität.
 * @var array $settings Globale UI- und App-Einstellungen.
 * @var bool $isDateValid Ob das Ticket im Datumsbereich liegt.
 * @var bool $isTimeAllowed Ob laut HolidayService jetzt die Einfahrt erlaubt ist.
 * @var string $allowedToday Textuelle Info zum nächsten erlaubten Einfahrts-Slot.
 * @var string $appRoot Absoluter Pfad zum Installationsverzeichnis.
 * @var string $cspNonce
 * @var string $opening Textuelle Zusammenfassung der Öffnungszeiten.
 * @var string|null $holidayNotice Warnung bei Feiertagen im gewählten Zeitraum.
 */

// 1. Logo-Logik
$logoFile = null;
foreach (['webp', 'png', 'jpg', 'jpeg'] as $ext) {
    // Prüfe absolut auf dem Server
    $serverPath = \rtrim($appRoot, '/\\') . '/public/assets/img/logo/kga.' . $ext;
    if (\file_exists($serverPath)) {
        $logoFile = 'assets/img/logo/kga.' . $ext;
        break;
    }
}

// 2. Status-Farbe bestimmen
$pageStateClass = 'state-bg-error'; // Default: Ungültig
if ($permit) {
    if ($permit->isSuspended()) {
        $pageStateClass = 'state-bg-error';
    } elseif ($isDateValid && $isTimeAllowed) {
        $pageStateClass = 'state-bg-valid';
    } elseif ($isDateValid && !$isTimeAllowed) {
        $pageStateClass = 'state-bg-rest';
    }
}

$layout = 'public';
$pageTitle = 'Status-Check - ' . ($settings['vereins_name'] ?? '');
?>

<main class="c-tab-content-container o-container o-container--small u-padding-block-l">
    <div class="c-card c-card--primary u-margin-inline-auto u-shadow-highlight">

        <header class="c-card__header u-text-center">
            <?php if ($logoFile) { ?>
                <img src="<?php echo $settings['base_url'] . $logoFile; ?>"
                     loading="lazy"
                     alt="Logo"
                     class="c-logo">
            <?php } ?>
            <p class="u-color-muted u-text-sm u-margin-block-none"><?php echo \htmlspecialchars($settings['vereins_name']); ?></p>
        </header>

        <div class="c-card__body u-text-center">

            <?php if ($permit) { ?>
                <?php if ($permit->isSuspended()) { ?>
                    <div class="u-color-danger">
                        <img src="<?php echo $asset->url('assets/img/icons/denied.webp'); ?>"
                             class="c-icon c-icon--xl"
                             loading="lazy"
                             alt="">
                        <h2 class="u-color-danger u-margin-block-start-m">ZUTRITT VERWEIGERT</h2>
                        <p class="u-font-semibold">Diese Genehmigung wurde gesperrt/widerrufen.</p>

                        <?php if (!empty($permit->getSuspensionReason())) { ?>
                            <div class="c-box c-box--danger-soft u-margin-block-start-m u-text-center">
                                <strong class="u-text-xs u-text-uppercase u-letter-spacing-sm">
                                    Grund der Sperrung:</strong><br>
                                <span class="u-text-lg u-display-block u-margin-block-start-xs"><?php echo \htmlspecialchars($permit->getSuspensionReason()); ?></span>
                            </div>
                        <?php } ?>
                    </div>
                <?php } elseif ($isDateValid && $isTimeAllowed) { ?>
                    <div class="u-color-success">
                        <img src="<?php echo $asset->url('assets/img/icons/success.webp'); ?>"
                             class="c-icon c-icon--xl"
                             loading="lazy"
                             alt="">
                        <h2 class="u-color-success-dark u-margin-block-start-m">GÜLTIG</h2>
                        <?php include $appRoot . '/templates/partials/frontend/check_details.phtml'; ?>
                    </div>
                <?php } elseif ($isDateValid && !$isTimeAllowed) { ?>
                    <div class="u-color-warning">
                        <span class="u-text-4xl">
                            <img src="<?php echo $asset->url('assets/img/icons/hourglass.webp'); ?>" class="c-icon c-button__icon" loading="lazy" alt="">
                        </span>
                        <h2 class="u-color-warning u-margin-block-start-m">AKTUELL RUHEZEIT<br>Keine Einfahrt erlaubt!
                        </h2>

                        <?php if (\str_contains($allowedToday, 'Gültigkeit')) { ?>
                            <!-- Sonderfall: Genehmigung läuft während der Ruhezeit ab -->
                            <p class="u-font-semibold"><?php echo $allowedToday; ?></p>
                        <?php } else { ?>
                            <!-- Normalfall: Nächste Zeit anzeigen -->
                            <p>Nächste Einfahrt möglich:<br><strong class="u-font-semibold"><?php echo $allowedToday; ?></strong></p>
                        <?php } ?>

                        <?php include $appRoot . '/templates/partials/frontend/check_details.phtml'; ?>
                    </div>
                <?php } else { ?>
                    <div class="u-color-muted">
                        <img src="<?php echo $asset->url('assets/img/icons/warning.webp'); ?>"
                             class="c-icon c-icon--xl"
                             loading="lazy"
                             alt="">
                        <h2 class="u-margin-block-start-m">UNGÜLTIG</h2>
                        <p>Zahlung offen, Zeitraum abgelaufen oder noch nicht erreicht.</p>
                    </div>
                <?php } ?>
            <?php } ?>
        </div>

        <?php if ($permit) { ?>
            <footer class="c-card__footer u-text-center">
                <p class="u-color-muted u-margin-block-end-s">SmartCode: <strong class="u-color-dark"><?php echo $permit->code; ?></strong>
                </p>
                <a href="admin?code=<?php echo $permit->code; ?>" class="u-text-link u-text-sm">Login für Details</a>
            </footer>
        <?php } ?>
    </div>
</main>
