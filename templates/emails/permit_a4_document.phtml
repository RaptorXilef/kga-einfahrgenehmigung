<?php

/**
 * Template: A4 Printable Permit Document (A4 Ausnahmegenehmigung)
 *
 * Das offizielle Genehmigungsdokument als PDF.
 * Diese Version ist optimiert für Dompdf. Keine Inline-Styles nötig!
 *
 * @var array $settings
 * @var array|string $opening
 * @var string $bis
 * @var string $bis_formatted
 * @var string $checkUrl
 * @var string $checkQrBase64
 * @var string $erstellt
 * @var string $firma
 * @var string $fullIdentifier
 * @var string $jahresFarbe
 * @var string $kennzeichen
 * @var string $name
 * @var string $parzelle
