<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;

/**
 * Partial: Dashboard Control Bar
 *
 * Suchleiste und Zeitraum-/Typen-Filter.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var array $settings
 * @var string $cspNonce
 * @var string $filterEnd
 * @var string $filterStart
 * @var string $filterType
 */
$filterType ??= 'all';
$sessionFilters = $_SESSION['admin_filters'] ?? [];
$currentStart = $sessionFilters['start'] ?? $filterStart;
$currentEnd = $sessionFilters['end'] ?? $filterEnd;
$currentType = $sessionFilters['type'] ?? $filterType;
$currentQ = $sessionFilters['q'] ?? '';
$currentLimit = $sessionFilters['limit'] ?? ($itemsPerPage ?? 25);
?>
<?php if ($auth->hasPermission('permits.view')) { ?>
    <div class="c-control-bar-wrapper">
        <section class="c-control-bar-section">
            <form method="POST"
                  action="<?php echo $settings['base_url']; ?>filter_dashboard"
                  id="dashboardFilterForm"
                  class="u-flex u-align-center u-gap-s u-flex-wrap u-width-100 u-justify-center u-margin-none">
                <input type="hidden"
                       name="csrf_token"
                       value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>">
                <input type="hidden"
                       name="page"
                       value="1">

                <label for="filter_start"
                       class="u-color-muted u-font-bold u-text-xs u-flex u-align-center u-gap-s u-cursor-pointer u-text-uppercase"
                       style="letter-spacing: 0.05em;">
                    <img src="<?php echo $asset->url('assets/img/icons/status-future.webp'); ?>"
                         class="c-icon"
                         alt="">
                    ZEITRAUM:
                </label>
                <input type="date"
                       id="filter_start"
                       name="start"
                       value="<?php echo \htmlspecialchars($currentStart); ?>"
                       class="c-control-bar-input"
                       autocomplete="off">

                <label for="filter_end"
                       class="u-color-muted u-text-xs u-font-extrabold u-cursor-pointer">BIS</label>
                <input type="date"
                       id="filter_end"
                       name="end"
                       value="<?php echo \htmlspecialchars($currentEnd); ?>"
                       class="c-control-bar-input"
                       autocomplete="off">

                <label for="filter_type"
                       class="u-color-muted u-font-bold u-text-xs u-cursor-pointer u-margin-left-xs u-text-uppercase"
                       style="letter-spacing: 0.05em;">TYP:</label>
                <select name="type"
                        id="filter_type"
                        class="c-control-bar-input js-auto-submit-select u-cursor-pointer"
                        style="inline-size: auto !important;"
                        autocomplete="off">
                    <option value="all"
                            <?php echo $currentType === 'all' ? 'selected' : ''; ?>>Alle Genehmigungen</option>
                    <option value="standard"
                            <?php echo $currentType === 'standard' ? 'selected' : ''; ?>>Nur Standard</option>
                    <option value="permanent"
                            <?php echo $currentType === 'permanent' ? 'selected' : ''; ?>>Nur Dauerkarten</option>
                </select>

                <label for="filter_limit"
                       class="u-color-muted u-font-bold u-text-xs u-cursor-pointer u-margin-left-xs u-text-uppercase"
                       style="letter-spacing: 0.05em;">PRO SEITE:</label>
                <select name="limit"
                        id="filter_limit"
                        class="c-control-bar-input js-auto-submit-select u-cursor-pointer"
                        style="inline-size: auto !important;"
                        autocomplete="off">
                    <?php foreach ($allowedLimits ?? [10, 25, 50, 100] as $l) { ?>
                        <option value="<?php echo $l; ?>"
                                <?php echo $currentLimit == $l ? 'selected' : ''; ?>><?php echo $l; ?></option>
                    <?php } ?>
                </select>

                <div class="u-position-relative u-margin-left-auto"
                     style="min-inline-size: 150px; max-inline-size: 230px;">
                    <span style="position: absolute; inset-inline-start: 15px; inset-block-start: 50%; transform: translateY(-50%); pointer-events: none; z-index: 10;">
                    <img src="<?php echo $asset->url('assets/img/icons/action-search.webp'); ?>" class="c-icon" alt="">
                </span>
                    <!-- name="q" und value aus PHP für Server-Side Search -->
                    <input type="text"
                           id="adminSearch"
                           name="q"
                           aria-label="Schnellsuche"
                           autocomplete="off"
                           value="<?php echo \htmlspecialchars($currentQ); ?>"
                           placeholder="Schnellsuche..."
                           title="Suchen Sie nach Namen, KFZ oder SmartCode"
                           class="c-form-input"
                           style="padding-inline-start: 42px; border-radius: 30px; block-size: 38px;">
                </div>

                <?php if (!empty($sessionFilters)) { ?>
                    <a href="?reset_filters=1" class="c-button c-button--secondary u-text-xs" style="padding-inline: 12px; block-size: 34px;">✕ Filter aufheben</a>
                <?php } ?>
                <!-- Versteckter Button, damit Formular via Enter absendbar ist -->
                <button type="submit"
                        class="u-hidden"></button>
            </form>
        </section>
    </div>

    <script nonce="<?php echo $cspNonce; ?>">
    document.addEventListener('DOMContentLoaded', () => {
        const filterStart = document.getElementById('filter_start');
        const filterEnd = document.getElementById('filter_end');

        if (filterStart && filterEnd) {
            filterStart.addEventListener('change', () => {
                if (filterStart.value && filterEnd.value && filterStart.value > filterEnd.value) {
                    filterEnd.value = filterStart.value;
                }
                document.getElementById('dashboardFilterForm').submit();
            });

            filterEnd.addEventListener('change', () => {
                if (filterStart.value && filterEnd.value && filterEnd.value < filterStart.value) {
                    filterStart.value = filterEnd.value;
                }
                document.getElementById('dashboardFilterForm').submit();
            });
        }
    });

    </script>
<?php } ?>
