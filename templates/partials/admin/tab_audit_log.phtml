<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Storage\ImageStorageService;

/**
 * Partial: Dashboard Tab - Audit Log (Nutzerprotokoll)
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var ImageStorageService $imageStorage
 * @var array $settings
 */
$auditLogs ??= [];
$auditTotal ??= 0;
$auditPage ??= 1;
$auditFilter ??= '';

$limit = $itemsPerPage ?? 25;
$auditTotalPages = \max(1, (int) \ceil($auditTotal / $limit));

$filterOptions = [
    '' => 'Alle Aktionen',
    'LOGIN' => 'Erfolgreiche Logins (Admin)',
    'LOGOUT' => 'Abmeldungen (Admin)',
    'PERMIT_CREATE' => 'Genehmigung erstellt',
    'PERMIT_PAID' => 'Zahlung bestätigt',
    'PERMIT_SUSPENSION' => 'Sperre / Freigabe',
    'PERMIT_PRINT' => 'Genehmigung gedruckt',
    'BANK_IMPORT' => 'Autom. Bankabgleich',
    'VOUCHER_CREATE' => 'Gutschein erstellt',
    'VOUCHER_TOGGLE' => 'Gutschein umgeschaltet',
    'VOUCHER_DELETE' => 'Gutschein gelöscht',
    'USER_CREATE' => 'Benutzer angelegt',
    'USER_RENAME' => 'Benutzer umbenannt',
    'USER_CHANGE_GROUP' => 'Rechte geändert',
    'USER_DELETE' => 'Benutzer gelöscht',
    'GROUP_CREATE' => 'Rollenmatrix erstellt',
    'GROUP_UPDATE' => 'Rollenmatrix bearbeitet',
    'GROUP_DELETE' => 'Rollenmatrix gelöscht',
    'SYSTEM_BACKUP_CREATE' => 'Backup ausgelöst',
    'DATA_EXPORT' => 'Daten exportiert',
    'USER_HISTORY_LOGIN' => 'Pächter-Logins (Verlauf)',
    'USER_PERMIT_CANCEL' => 'Pächter-Stornos',
];

// Paginierung als HTML-String vorrendern
$paginationHtml = '';
if ($auditTotalPages > 1) {
    $queryParams = $_GET;
    unset($queryParams['audit_page']);
    $baseUrlStr = '?' . \http_build_query($queryParams) . '&audit_page=';

    $adjacents = 2;
    $pagesToShow = [];
    if ($auditTotalPages <= (1 + ($adjacents * 2) + 2)) {
        for ($i = 1; $i <= $auditTotalPages; ++$i) {
            $pagesToShow[] = $i;
        }
    } else {
        if ($auditPage <= $adjacents + 2) {
            for ($i = 1; $i <= 1 + ($adjacents * 2); ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $auditTotalPages;
        } elseif ($auditTotalPages - $auditPage <= $adjacents + 1) {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $auditTotalPages - ($adjacents * 2); $i <= $auditTotalPages; ++$i) {
                $pagesToShow[] = $i;
            }
        } else {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $auditPage - $adjacents; $i <= $auditPage + $adjacents; ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $auditTotalPages;
        }
    }

    \ob_start();
    ?>
    <div class="c-pagination">
        <div class="c-pagination__info">
            Zeige <?php echo (($auditPage - 1) * $limit) + 1; ?> bis <?php echo \min($auditPage * $limit, $auditTotal); ?> von <strong><?php echo $auditTotal; ?></strong>
        </div>
        <div class="c-pagination__controls">
            <?php if ($auditPage > 1) { ?>
                <a href="<?php echo $baseUrlStr . ($auditPage - 1); ?>" class="c-button c-button--secondary c-button--icon-only">&larr;</a>
            <?php } else { ?>
                <button class="c-button c-button--secondary c-button--icon-only u-opacity-50"
                        disabled>&larr;</button>
            <?php } ?>

            <?php foreach ($pagesToShow as $pageNum) {
                if ($pageNum === '...') { ?>
                    <span class="u-color-muted u-padding-x-s">&hellip;</span>
                <?php } elseif ($pageNum === $auditPage) { ?>
                    <button class="c-button c-button--primary"
                            style="pointer-events: none;"><?php echo $pageNum; ?></button>
                <?php } else { ?>
                    <a href="<?php echo $baseUrlStr . $pageNum; ?>" class="c-button c-button--secondary"><?php echo $pageNum; ?></a>
            <?php }
                } ?>

            <?php if ($auditPage < $auditTotalPages) { ?>
                <a href="<?php echo $baseUrlStr . ($auditPage + 1); ?>" class="c-button c-button--secondary c-button--icon-only">&rarr;</a>
            <?php } else { ?>
                <button class="c-button c-button--secondary c-button--icon-only u-opacity-50"
                        disabled>&rarr;</button>
            <?php } ?>
        </div>
    </div>
<?php
    $paginationHtml = \ob_get_clean();
} elseif ($auditTotal > 0) {
    $paginationHtml = '<div class="u-text-center u-padding-around-s u-color-muted u-text-sm u-border-top" style="background-color: var(--color-bg-light);">Gesamt: <strong>' . $auditTotal . '</strong> Einträge</div>';
}

if ($auth->hasPermission('system.logs.view')) {
    ?>
    <div class="c-tab-content-container">
        <section class="c-card c-card--dark">
            <header class="c-card__header u-flex u-justify-between u-align-center u-flex-wrap u-gap-m">
                <div>
                    <h3 class="u-margin-none">
                        <img src="<?php echo $asset->url('assets/img/icons/icon-user.webp'); ?>"
                             class="c-icon"
                             alt=""> Administrator-Aktivitäten
                    </h3>
                    <p class="u-color-muted u-text-sm u-margin-none u-margin-top-xs">Protokolliert sicherheitsrelevante
                        Änderungen durch eingeloggte Nutzer.</p>
                </div>
                <form method="GET"
                      action="?"
                      class="u-flex u-align-center u-gap-s u-margin-none">
                    <span class="u-text-sm u-font-bold u-color-muted">FILTER:</span>
                    <select name="audit_filter"
                            class="c-form-select js-auto-submit-select c-button--small">
                        <?php foreach ($filterOptions as $val => $label) { ?>
                            <option value="<?php echo $val; ?>"
                                    <?php echo $auditFilter === $val ? 'selected' : ''; ?>><?php echo $label; ?></option>
                        <?php } ?>
                    </select>
                    <?php if ($auditFilter !== '') { ?>
                        <a href="?" class="c-button c-button--danger-outline c-button--icon-only c-button--small u-text-xl" title="Filter löschen">&times;</a>
                    <?php } ?>
                </form>
            </header>

            <?php echo $paginationHtml; ?>

            <div class="c-card__body u-padding-none u-overflow-x-auto">
                <table class="c-table u-width-100">
                    <thead>
                        <tr>
                            <th class="u-text-left">Zeitpunkt</th>
                            <th class="u-text-left">Aktion</th>
                            <th class="u-text-left">System-Details</th>
                            <th class="u-text-left u-padding-right-m">Ausführender Benutzer</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (empty($auditLogs)) { ?>
                            <tr>
                                <td colspan="4"
                                    class="u-text-center u-padding-around-l u-color-muted">
                                    Keine Protokolleinträge für diesen Filter gefunden.
                                </td>
                            </tr>
                        <?php } else { ?>
                            <?php foreach ($auditLogs as $log) {
                                $avatar = $imageStorage->getImageUrl('user_images', $log->userId, 'icon-user-default.webp');
                                ?>
                                <tr class="u-hover-fade">
                                    <td class="u-text-nowrap">
                                        <div class="u-line-height-1-2">
                                            <span class="u-text-sm u-color-main u-font-semibold"><?php echo $log->createdAt->format('d.m.Y'); ?></span><br>
                                            <small class="u-color-muted"><?php echo $log->createdAt->format('H:i:s'); ?> Uhr</small>
                                        </div>
                                    </td>
                                    <td>
                                        <code class="c-badge c-badge--primary u-font-mono"><?php echo \htmlspecialchars($log->action); ?></code>
                                    </td>
                                    <td>
                                        <span class="u-text-sm u-color-dark u-display-block">
                                            <?php echo \htmlspecialchars($log->details); ?>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="u-flex u-align-center u-gap-s">
                                            <img src="<?php echo $avatar; ?>"
                                                 class="c-icon c-icon--md u-border-radius-circle">
                                            <div>
                                                <strong class="u-text-sm u-color-main"><?php echo \htmlspecialchars($log->username); ?></strong><br>
                                                <small class="u-color-muted u-font-mono u-text-xs"
                                                       title="IP-Adresse: <?php echo \htmlspecialchars($log->ipAddress); ?>">
                                                    <?php echo \htmlspecialchars($log->userId); ?>
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <?php } ?>
                        <?php } ?>
                    </tbody>
                </table>
            </div>

            <?php echo $paginationHtml; ?>
        </section>
    </div>
<?php } ?>
