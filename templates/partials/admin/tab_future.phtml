 */
$now = new \DateTimeImmutable('today');
$allFuture = $permitGroups['future'] ?? [];

// Sortierung - Was als nächstes aktiv wird zuerst (von ASC)
\usort($allFuture, fn ($a, $b) => $a->getValidFrom() <=> $b->getValidFrom());

// Paginierungs-Logik
$limit = $itemsPerPage ?? 25;
$page = $currentPage ?? 1;
$totalCount = \count($allFuture);
$totalPages = \max(1, (int) \ceil($totalCount / $limit));
$page = \min($page, $totalPages);
$offset = ($page - 1) * $limit;

$futurePermits = \array_slice($allFuture, $offset, $limit);

\ob_start();
$paginationParam = 'page';
include $appRoot . '/templates/partials/admin/pagination.phtml';
