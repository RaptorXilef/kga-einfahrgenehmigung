<?php

use App\Application\View\PaginationViewDto;

/**
 * Partial: Generic Pagination Component
 * VSA FIX: 100% Dumme View - konsumiert ausschließlich das vorberechnete PaginationViewDto.
 *
 * @var PaginationViewDto $paginationDto
 */
if ($paginationDto->hasMultiplePages) { ?>
<div class="c-pagination">
    <div class="c-pagination__info">
        Zeige <?php echo $paginationDto->startEntry; ?> bis <?php echo $paginationDto->endEntry; ?> von
        <strong><?php echo $paginationDto->totalCount; ?></strong>
    </div>
    <div class="c-pagination__controls">
        <?php if ($paginationDto->hasPrev) { ?>
        <a
            href="<?php echo \htmlspecialchars($paginationDto->prevUrl, \ENT_QUOTES, 'UTF-8'); ?>"
            class="c-button c-button--secondary c-button--icon-only"
        >&larr;</a>
        <?php } else { ?>
        <button
            class="c-button c-button--secondary c-button--icon-only u-opacity-50"
            disabled
        >&larr;</button>
        <?php } ?>

        <?php foreach ($paginationDto->items as $item) {
            if ($item->isEllipsis) { ?>
        <span class="u-color-muted u-padding-inline-s">&hellip;</span>
        <?php } elseif ($item->isCurrent) { ?>
        <span
            class="c-button c-button--primary"
            aria-current="page"
        ><?php echo \htmlspecialchars($item->label); ?></span>
        <?php } else { ?>
        <a
            href="<?php echo \htmlspecialchars($item->url, \ENT_QUOTES, 'UTF-8'); ?>"
            class="c-button c-button--secondary"
        ><?php echo \htmlspecialchars($item->label); ?></a>
        <?php }
            } ?>

        <?php if ($paginationDto->hasNext) { ?>
        <a
            href="<?php echo \htmlspecialchars($paginationDto->nextUrl, \ENT_QUOTES, 'UTF-8'); ?>"
            class="c-button c-button--secondary c-button--icon-only"
        >&rarr;</a>
        <?php } else { ?>
        <button
            class="c-button c-button--secondary c-button--icon-only u-opacity-50"
            disabled
        >&rarr;</button>
        <?php } ?>
    </div>
</div>
<?php } elseif ($paginationDto->hasEntries) { ?>
<div class="u-text-center u-padding-around-s u-color-muted u-text-sm u-border-block-start u-bg-light">Gesamt:
    <strong><?php echo $paginationDto->totalCount; ?></strong> Einträge
</div>
<?php } ?>
