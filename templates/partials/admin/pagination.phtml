<?php

/**
 * Partial: Generic Pagination Component
 *
 * Erwartet folgende Variablen im Scope:
 * @var int $page             Aktuelle Seite
 * @var int $totalPages       Gesamtanzahl der Seiten
 * @var int $totalCount       Gesamtanzahl der Datensätze
 * @var int $limit            Einträge pro Seite
 * @var int $offset           Aktueller Offset
 * @var string $paginationParam Der GET-Parameter für die Seite (Standard: 'page', bei Audit-Log z.B. 'audit_page')
 * @var string|null $tabFocusId Die explizite Tab-ID (z.B. 'tab-active'), um URL-Leaks zu verhindern
 */
$paginationParam ??= 'page';

if ($totalPages > 1) {
    $queryParams = $_GET;

    // ARCHITEKTUR-FIX: Verhindert "Parameter Leakage" und kryptische URLs.
    // 1. Wir löschen pauschal alle bekannten Paginierungs-Parameter aus der URL-Basis
    unset($queryParams['page'], $queryParams['audit_page']);

    // 2. Wenn wir nicht in einem Tab sind, der das Archiv nutzt, werfen wir das auch raus
    if (isset($tabFocusId) && !\in_array($tabFocusId, ['tab-expired', 'tab-stats'], true)) {
        unset($queryParams['archive_depth']);
    }

    // 3. Jeder Paginierungs-Link bekommt zwingend die ID seines eigenen Tabs aufgestempelt.
    if (isset($tabFocusId)) {
        $queryParams['focus'] = $tabFocusId;
    } else {
        unset($queryParams['focus']);
    }

    $baseUrlStr = '?' . \http_build_query($queryParams) . '&' . $paginationParam . '=';

    $adjacents = 2;
    $pagesToShow = [];
    if ($totalPages <= (1 + ($adjacents * 2) + 2)) {
        for ($i = 1; $i <= $totalPages; ++$i) {
            $pagesToShow[] = $i;
        }
    } else {
        if ($page <= $adjacents + 2) {
            for ($i = 1; $i <= 1 + ($adjacents * 2); ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $totalPages;
        } elseif ($totalPages - $page <= $adjacents + 1) {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $totalPages - ($adjacents * 2); $i <= $totalPages; ++$i) {
                $pagesToShow[] = $i;
            }
        } else {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $page - $adjacents; $i <= $page + $adjacents; ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $totalPages;
        }
    }
    ?>
<div class="c-pagination">
    <div class="c-pagination__info">
        Zeige <?php echo $offset + 1; ?> bis <?php echo \min($offset + $limit, $totalCount); ?> von
        <strong><?php echo $totalCount; ?></strong>
    </div>
    <div class="c-pagination__controls">
        <?php if ($page > 1) { ?>
        <a
            href="<?php echo $baseUrlStr . ($page - 1); ?>"
            class="c-button c-button--secondary c-button--icon-only"
        >&larr;</a>
        <?php } else { ?>
        <button
            class="c-button c-button--secondary c-button--icon-only u-opacity-50"
            disabled
        >&larr;</button>
        <?php } ?>

        <?php foreach ($pagesToShow as $pageNum) {
                if ($pageNum === '...') { ?>
        <span class="u-color-muted u-padding-inline-s">&hellip;</span>
        <?php } elseif ($pageNum === $page) { ?>
        <span
            class="c-button c-button--primary"
            aria-current="page"
        ><?php echo $pageNum; ?></span>
        <?php } else { ?>
        <a
            href="<?php echo $baseUrlStr . $pageNum; ?>"
            class="c-button c-button--secondary"
        ><?php echo $pageNum; ?></a>
        <?php }
                } ?>

        <?php if ($page < $totalPages) { ?>
        <a
            href="<?php echo $baseUrlStr . ($page + 1); ?>"
            class="c-button c-button--secondary c-button--icon-only"
        >&rarr;</a>
        <?php } else { ?>
        <button
            class="c-button c-button--secondary c-button--icon-only u-opacity-50"
            disabled
        >&rarr;</button>
        <?php } ?>
    </div>
</div>
<?php } elseif ($totalCount > 0) { ?>
<div class="u-text-center u-padding-around-s u-color-muted u-text-sm u-border-block-start u-bg-light">Gesamt:
    <strong><?php echo $totalCount; ?></strong> Einträge
</div>
<?php } ?>
