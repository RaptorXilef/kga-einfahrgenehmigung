<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Config\Config;

/**
 * Partial: Dashboard Tab - Expired Permits
 *
 * Historisches Archiv der abgelaufenen Genehmigungen im gewählten Zeitraum.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var array $permitGroups
 * @var array $settings
 * @var int $minArchiveYear
 */
$allExpired = $permitGroups['expired'] ?? [];

\usort($allExpired, fn ($a, $b) => $b->getValidUntil() <=> $a->getValidUntil());

// Paginierungs-Logik
$limit = $itemsPerPage ?? 25;
$page = $currentPage ?? 1;
$totalCount = \count($allExpired);
$totalPages = \max(1, (int) \ceil($totalCount / $limit));
$page = \min($page, $totalPages);
$offset = ($page - 1) * $limit;

$expiredPermits = \array_slice($allExpired, $offset, $limit);

// Paginierung als HTML-String vorrendern
$paginationHtml = '';
if ($totalPages > 1) {
    $queryParams = $_GET;
    unset($queryParams['page']);
    $baseUrlStr = '?' . \http_build_query($queryParams) . '&page=';

    $adjacents = 2;
    $pagesToShow = [];
    if ($totalPages <= (1 + ($adjacents * 2) + 2)) {
        for ($i = 1; $i <= $totalPages; ++$i) {
            $pagesToShow[] = $i;
        }
    } else {
        if ($page <= $adjacents + 2) {
            for ($i = 1; $i <= 1 + ($adjacents * 2); ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $totalPages;
        } elseif ($totalPages - $page <= $adjacents + 1) {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $totalPages - ($adjacents * 2); $i <= $totalPages; ++$i) {
                $pagesToShow[] = $i;
            }
        } else {
            $pagesToShow[] = 1;
            $pagesToShow[] = '...';
            for ($i = $page - $adjacents; $i <= $page + $adjacents; ++$i) {
                $pagesToShow[] = $i;
            }
            $pagesToShow[] = '...';
            $pagesToShow[] = $totalPages;
        }
    }

    \ob_start();
    ?>
    <div class="c-pagination">
        <div class="c-pagination__info">
            Zeige <?php echo $offset + 1; ?> bis <?php echo \min($offset + $limit, $totalCount); ?> von <strong><?php echo $totalCount; ?></strong>
        </div>
        <div class="c-pagination__controls">
            <?php if ($page > 1) { ?>
                <a href="<?php echo $baseUrlStr . ($page - 1); ?>" class="c-button c-button--secondary c-button--icon-only">&larr;</a>
            <?php } else { ?>
                <button class="c-button c-button--secondary c-button--icon-only u-opacity-50"
                        disabled>&larr;</button>
            <?php } ?>

            <?php foreach ($pagesToShow as $pageNum) {
                if ($pageNum === '...') { ?>
                    <span class="u-color-muted u-padding-x-s">&hellip;</span>
                <?php } elseif ($pageNum === $page) { ?>
                    <button class="c-button c-button--primary"
                            style="pointer-events: none;"><?php echo $pageNum; ?></button>
                <?php } else { ?>
                    <a href="<?php echo $baseUrlStr . $pageNum; ?>" class="c-button c-button--secondary"><?php echo $pageNum; ?></a>
            <?php }
                } ?>

            <?php if ($page < $totalPages) { ?>
                <a href="<?php echo $baseUrlStr . ($page + 1); ?>" class="c-button c-button--secondary c-button--icon-only">&rarr;</a>
            <?php } else { ?>
                <button class="c-button c-button--secondary c-button--icon-only u-opacity-50"
                        disabled>&rarr;</button>
            <?php } ?>
        </div>
    </div>
<?php
    $paginationHtml = \ob_get_clean();
} elseif ($totalCount > 0) {
    $paginationHtml = '<div class="u-text-center u-padding-around-s u-color-muted u-text-sm u-border-top" style="background-color: var(--color-bg-light);">Gesamt: <strong>' . $totalCount . '</strong> Einträge</div>';
}

if ($auth->hasPermission('permits.view')) {
    ?>
    <div class="c-tab-content-container">
        <section class="c-card c-card--dark">
            <header class="c-card__header u-flex u-justify-between u-align-center">
                <div>
                    <h3 class="u-margin-none">
                        <img src="<?php echo $asset->url('assets/img/icons/status-expired.webp'); ?>"
                             class="c-icon"
                             alt=""> Historisches Archiv
                    </h3>
                    <p class="u-color-muted u-text-sm u-margin-none">Abgelaufene Genehmigungen aus dem gewählten
                        Zeitraum.</p>
                </div>
                <span class="c-badge c-badge--outline">ARCHIV: <?php echo \count($allExpired); ?></span>
            </header>

            <?php echo $paginationHtml; ?>

            <div class="c-card__body u-padding-none u-overflow-x-auto">
                <table class="c-table js-sort-table u-width-100">
                    <thead>
                        <tr>
                            <th class="js-sort-header u-text-left">Antragsteller & Kennung</th>
                            <th class="js-sort-header u-text-center">Fahrzeug</th>
                            <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                                <th class="js-sort-header u-text-left">Kontakt (E-Mail)</th>
                            <?php } ?>
                            <th class="js-sort-header u-text-center">Zeitraum</th>
                            <th class="u-text-right u-padding-right-m">Verwaltung</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (empty($expiredPermits)) { ?>
                            <tr>
                                <td colspan="5"
                                    class="u-text-center u-padding-around-l u-color-muted">
                                    Keine abgelaufenen Einträge im gewählten Zeitraum.
                                </td>
                            </tr>
                        <?php } else { ?>
                            <?php foreach ($expiredPermits as $permit) {
                                $vKey = $permit->getVehicleType();
                                $vCfg = $config->get('vehicle_types')[$vKey] ?? null;
                                $iconPath = $vCfg['icon'] ?? 'assets/img/icons/status-invalid.webp';
                                $vLabel = $vCfg['label'] ?? 'Ehem. ' . \strtoupper($vKey);
                                ?>
                                <tr class="u-hover-fade u-opacity-75">
                                    <!-- 1. Pächter, Code & Parzelle -->
                                    <td data-sort-val="<?php echo \htmlspecialchars($permit->getOwnerName()); ?>">
                                        <div class="u-flex u-flex-column">
                                            <span class="u-font-bold u-color-main"><?php echo \htmlspecialchars($permit->getOwnerName()); ?></span>
                                            <code class="u-text-xs u-color-muted u-font-mono u-margin-y-xs"><?php echo $permit->code; ?></code>
                                            <div>
                                                <span class="c-badge c-badge--primary">PARZELLE <?php echo $permit->getPlotNumber(); ?></span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- 2. Fahrzeug unter Icon (Nummernschild-Style) -->
                                    <td data-sort-val="<?php echo \htmlspecialchars($permit->getLicensePlate()); ?>"
                                        class="u-text-center">
                                        <div>
                                            <img src="<?php echo $settings['base_url'] . $iconPath; ?>"
                                                 class="c-icon c-icon--md u-grayscale u-opacity-50"
                                                 title="<?php echo $vLabel; ?>">
                                        </div>
                                        <div class="u-margin-top-xs">
                                            <span class="c-license-plate u-text-nowrap"><?php echo \htmlspecialchars($permit->getLicensePlate() ?: '---'); ?></span>
                                        </div>
                                    </td>

                                    <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                                        <td data-sort-val="<?php echo \htmlspecialchars($permit->getOwnerEmail()); ?>">
                                            <?php if ($permit->getOwnerEmail()) { ?>
                                                <div class="u-flex u-align-center u-gap-xs">
                                                    <img src="<?php echo $asset->url('assets/img/icons/icon-envelope.webp'); ?>"
                                                         class="c-icon c-icon--inline"
                                                         alt="">
                                                    <small>
                                                        <!-- FIX: Email sicher am @ umbrechen (ohne Whitespaces) -->
                                                        <a href="mailto:<?php echo \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8'); ?>" class="u-text-link">
                                                            <?php echo \str_replace('@', '&#8203;@&#8203;', \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8')); ?>
                                                        </a>
                                                    </small>
                                                </div>
                                            <?php } else { ?>
                                                <small class="u-color-muted"><em>keine Angabe</em></small>
                                            <?php } ?>
                                        </td>
                                    <?php } ?>

                                    <!-- 4. Zeitraum -->
                                    <td data-sort-val="<?php echo $permit->getValidFrom()->format('Y-m-d'); ?>"
                                        class="u-text-center u-text-nowrap">
                                        <div>
                                            <small class="u-color-muted">
                                                <?php echo $permit->getValidFrom()->format('d.m.Y'); ?> -<br>
                                                <?php echo $permit->getValidUntil()->format('d.m.Y'); ?>
                                            </small>
                                        </div>
                                    </td>

                                    <td class="u-text-right u-text-nowrap u-padding-right-m">
                                        <div class="u-flex u-gap-xs u-justify-end">
                                            <?php if ($auth->hasPermission('permits.print')) { ?>
                                                <a href="admin_print?code=<?php echo $permit->code; ?>" target="_blank" class="c-button c-button--secondary c-button--small c-button--icon-only" title="Drucken">
                                                    <img src="<?php echo $asset->url('assets/img/icons/action-print.webp'); ?>" class="c-icon" alt="">
                                                </a>
                                            <?php } ?>
                                            <?php if ($auth->hasPermission('permits.view')) { ?>
                                                <a href="check?code=<?php echo $permit->code; ?>" target="_blank" class="c-button c-button--secondary c-button--small c-button--icon-only" title="Details">
                                                    <img src="<?php echo $asset->url('assets/img/icons/action-view.webp'); ?>" class="c-icon" alt="">
                                                </a>
                                            <?php } ?>
                                        </div>
                                    </td>
                                </tr>
                            <?php } ?>
                        <?php } ?>
                    </tbody>
                </table>
            </div>

            <?php echo $paginationHtml; ?>

            <div class="c-card__footer u-text-center">
                <?php
                $queryParams = $_GET;
    $queryParams['archive_depth'] = $minArchiveYear - 1;
    $loadUrl = '?' . \http_build_query($queryParams);
    ?>
                <a href="<?php echo $loadUrl; ?>" class="c-button c-button--secondary">
                    <img src="<?php echo $asset->url('assets/img/icons/icon_inbox-tray.webp'); ?>" class="c-icon" alt="">
                    &nbsp; Daten aus dem Jahr <?php echo $minArchiveYear - 1; ?> dazuladen
                </a>
                <p class="u-text-sm u-color-muted u-margin-top-s u-margin-bottom-none">
                    Aktuell im Speicher: Daten bis einschließlich <strong class="u-color-main"><?php echo $minArchiveYear; ?></strong>. <br>
                    <em>Aus Performance-Gründen werden ältere Archiv-Einträge nicht automatisch geladen.</em>
                </p>
            </div>
        </section>
    </div>
<?php } ?>
