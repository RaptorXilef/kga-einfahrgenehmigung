                            <th class="c-table__header-cell js-sort-header u-text-start">Antragsteller & Kennung</th>
                            <th class="c-table__header-cell js-sort-header u-text-center">Fahrzeug</th>
                            <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                                <th class="c-table__header-cell js-sort-header u-text-start">Kontakt (E-Mail)</th>
                            <?php } ?>
