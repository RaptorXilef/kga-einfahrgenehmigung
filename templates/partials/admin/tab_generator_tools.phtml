<script type="module">
// Wir laden die JS-Klasse dynamisch in den Adminbereich, die auch das Frontend nutzt!
// Dadurch gelten für die linke Karte ("Genehmigung ausstellen") 100% die identischen Validierungs-Regeln.
import {
    PermitFormHandler
} from '<?php echo $asset->url('assets/js/form-handler.js'); ?>';

document.addEventListener('DOMContentLoaded', () => {
    // Initialisiert den Handler für das Formular (greift über die ID 'permitForm')
    if (document.getElementById('permitForm') && !window.adminPermitForm) {
        window.adminPermitForm = new PermitFormHandler();
    }
});

</script>
