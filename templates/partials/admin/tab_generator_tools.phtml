 * @var AuthService $auth
 * @var Config $config
 * @var array<string, mixed> $settings
 * @var array<int, \App\Core\Entity\Permit> $allPermits
 */
$allowedTemplates = [];
foreach ($config->get('permit_templates', []) as $key => $tpl) {
    if ($auth->hasPermission("template.$key")) {
        $allowedTemplates[$key] = $tpl;
    }
}

$hasAnyTemplate = !empty($allowedTemplates);
$reasons = $config->get('internal_reasons', ['Barzahlung vor Ort', 'Vorstandsbeschluss']);
$standardPurposes = $config->get('purposes', []);

// Extrahiere alle bisher genutzten EIGENEN Gründe aus der Datenbank (für Auto-Complete)
$customPurposes = [];
if (isset($allPermits) && \is_array($allPermits)) {
    foreach ($allPermits as $p) {
        $z = $p->getPurpose();
        if ($z !== '' && !\in_array($z, $standardPurposes, true)) {
            $customPurposes[$z] = $z;
        }
    }
    \ksort($customPurposes);
}

// Vorbereitung für JavaScript Preiskalkulation
$tplMetadata = [];
foreach ($config->get('permit_templates', []) as $key => $tpl) {
    $tplMetadata[$key] = [
        'days' => $tpl['days'],
        'type' => $tpl['type'],
        'prices' => $tpl['prices'],
    ];
}
