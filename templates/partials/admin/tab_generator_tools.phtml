<script>
// Lokales UI-Update für die rechte Gutschein-Karte
function updateAdminVoucherUI() {
    const type = document.getElementById('v_type').value;
    const wrap = document.getElementById('v_val_wrap');
    wrap.style.display = type === 'free' ? 'none' : 'block';
}

// Wechselt zwischen Dropdown (Standard-Gründe) und Textfeld (Eigener Grund)
function toggleZweckMode() {
    const select = document.getElementById('zweck_select');
    const manual = document.getElementById('zweck_manual');
    const btn = document.getElementById('toggle_zweck_btn');

    if (select.classList.contains('u-hidden')) {
        // Dropdown anzeigen
        select.classList.remove('u-hidden');
        select.name = 'zweck';
        manual.classList.add('u-hidden');
        manual.name = '_unused_zweck';
        btn.innerHTML =
            `<img src="${window.KGA_CONFIG.baseUrl}assets/img/icons/icon-crayon.webp" class="c-icon" alt=""> Manuell`;
    } else {
        // Textfeld anzeigen
        select.classList.add('u-hidden');
        select.name = '_unused_zweck';
        manual.classList.remove('u-hidden');
        manual.name = 'zweck';
        btn.innerHTML =
            `<img src="${window.KGA_CONFIG.baseUrl}assets/img/icons/icon-open-file-folder.webp" class="c-icon" alt=""> Aus Liste`;
        manual.focus();
    }
}
window.toggleZweckMode = toggleZweckMode;


// --- FIX: DECOUPLED ADMIN JAVASCRIPT ---
// Dies ersetzt das fehleranfällige form-handler.js aus dem Frontend
// und bietet stattdessen exakte Datums-Synchronisation und Preis-Updates für das Backend an.
document.addEventListener('DOMContentLoaded', () => {
    const templates = <?php echo \json_encode($tplMetadata); ?>;

    // 1. Funktion zur Synchronisation der Start- und Enddaten
    function bindDateSync(tplId, vonId, bisId) {
        const tplEl = document.getElementById(tplId);
        const vonEl = document.getElementById(vonId);
        const bisEl = document.getElementById(bisId);

        if (!tplEl || !vonEl || !bisEl) return;

        const todayStr = new Date().toISOString().split('T')[0];
        vonEl.min = todayStr; // Verhindert Daten in der Vergangenheit

        function updateDates(source) {
            // Korrigiere Startdatum, falls es in der Vergangenheit liegt
            if (source === 'von' && vonEl.value < todayStr) vonEl.value = todayStr;

            const config = templates[tplEl.value];
            if (!config) return;

            const isCustom = config.days === 'custom';
            const duration = isCustom ? 0 : parseInt(config.days);
            const durationOffset = Math.max(0, duration - 1);

            if (!isCustom) {
                // Min-Wert für Bis-Feld berechnen (Heute + Dauer)
                let minBisDate = new Date();
                minBisDate.setDate(minBisDate.getDate() + durationOffset);
                const minBisStr = minBisDate.toISOString().split('T')[0];
                bisEl.min = minBisStr;

                if (source === 'bis') {
                    if (bisEl.value < minBisStr) bisEl.value = minBisStr;
                    let d = new Date(bisEl.value);
                    d.setDate(d.getDate() - durationOffset);
                    vonEl.value = d.toISOString().split('T')[0];
                } else {
                    if (!vonEl.value || vonEl.value < todayStr) vonEl.value = todayStr;
                    let d = new Date(vonEl.value);
                    d.setDate(d.getDate() + durationOffset);
                    bisEl.value = d.toISOString().split('T')[0];
                }
            } else {
                bisEl.min = vonEl.value;
                if (bisEl.value < vonEl.value) bisEl.value = vonEl.value;
            }
        }

        tplEl.addEventListener('change', () => updateDates('template'));
        vonEl.addEventListener('change', () => updateDates('von'));
        bisEl.addEventListener('change', () => updateDates('bis'));

        // Initiale Berechnung beim Laden der Seite
        updateDates('init');
    }

    // Binde beide Formulare (Manuell & Gutschein)
    bindDateSync('template_key', 'datum_von', 'datum_bis');
    bindDateSync('v_template_key', 'v_datum_von', 'v_datum_bis');

    // 2. Preisberechnung (Live-Update via API) für das manuelle Formular
    async function updateAdminPrice() {
        const tpl = document.getElementById('template_key')?.value;
        const typ = document.getElementById('typ')?.value;
        const priceDisplay = document.getElementById('price-display');

        if (!tpl || !typ || !priceDisplay) return;

        try {
            const res = await fetch(window.KGA_CONFIG.baseUrl + 'api/get_template_price', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': window.KGA_CONFIG.csrfToken
                },
                body: JSON.stringify({
                    key: tpl,
                    typ: typ,
                    voucher: ''
                })
            });
            const data = await res.json();
            if (data.success) {
                priceDisplay.innerText = data.formatted;
            }
        } catch (e) {
            console.error('Preiskalkulation fehlgeschlagen:', e);
        }
    }

    document.getElementById('template_key')?.addEventListener('change', updateAdminPrice);
    document.getElementById('typ')?.addEventListener('change', updateAdminPrice);

    // 3. Firmenfeld umschalten
    function toggleAdminFirma() {
        const typ = document.getElementById('typ')?.value;
        const firmaWrapper = document.getElementById('group_firma');
        const kennzeichenLabel = document.getElementById('label_kennzeichen');
        const kennzeichenInput = document.getElementById('kennzeichen');

        if (!typ || !firmaWrapper) return;

        const cfg = window.KGA_CONFIG.vehicleConfig[typ] || {
            show_company: false
        };
        if (cfg.show_company) {
            firmaWrapper.classList.remove('u-hidden');
            if (kennzeichenLabel) kennzeichenLabel.innerText = "Amtl. Kennzeichen (Optional)";
            if (kennzeichenInput) kennzeichenInput.required = false;
        } else {
            firmaWrapper.classList.add('u-hidden');
            if (kennzeichenLabel) kennzeichenLabel.innerText = "Amtl. Kennzeichen *";
            if (kennzeichenInput) kennzeichenInput.required = true;
            const firmaInput = firmaWrapper.querySelector('input');
            if (firmaInput) firmaInput.value = '';
        }
    }

    document.getElementById('typ')?.addEventListener('change', toggleAdminFirma);

    // Alles initial triggern
    updateAdminPrice();
    toggleAdminFirma();
});

</script>
