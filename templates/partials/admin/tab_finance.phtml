    <script>
    function updateBulkPayButton() {
        const checkboxes = document.querySelectorAll('.js-bulk-pay-cb:checked');
        const btnPay = document.getElementById('bulkPayBtn');
        const btnRemind = document.getElementById('bulkRemindBtn');
        const countSpanPay = document.getElementById('bulkPayCount');
        const countSpanRemind = document.getElementById('bulkRemindCount');

        if (btnPay && countSpanPay && btnRemind && countSpanRemind) {
            countSpanPay.innerText = checkboxes.length;
            countSpanRemind.innerText = checkboxes.length;

            const displayStyle = checkboxes.length > 0 ? 'inline-flex' : 'none';
            btnPay.style.display = displayStyle;
            btnRemind.style.display = displayStyle;
        }
    }

    function toggleAllBulkPay(source) {
        document.querySelectorAll('.js-bulk-pay-cb').forEach(cb => {
            cb.checked = source.checked;
        });
        updateBulkPayButton();
    }

    </script>
