// Sortierung - Am längsten überfällig / am wenigsten Zeit zuerst
\usort($allUnpaid, function ($a, $b) use ($dueDaysCfg) {
    $deadlineA = $a->getCreatedAt()->modify("+$dueDaysCfg days");
    $deadlineB = $b->getCreatedAt()->modify("+$dueDaysCfg days");

    return $deadlineA <=> $deadlineB; // Älteste Deadline zuerst
});

