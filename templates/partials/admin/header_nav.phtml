<?php

use App\Contracts\Storage\RoleRepositoryInterface;
use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Storage\ImageStorageService;

/**
 * Component: Administrative Header Navigation
 *
 * Beinhaltet das Top-Menü für eingeloggte Administratoren, Profil-Shortcuts und System-Links.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var ImageStorageService $imageStorage
 * @var RoleRepositoryInterface $roleRepository
 * @var array $settings
 * @var array $allReleaseNotes
 */
$roleId = $auth->getRole();
$roleName = $roleId;
if (isset($roleRepository) && $auth->isLoggedIn()) {
    $roles = $roleRepository->loadAll();
    $roleName = isset($roles[$roleId]) ? $roles[$roleId]->name : $roleId;
}
$userImgUrl = isset($imageStorage) ? $imageStorage->getImageUrl('user_images', $auth->getUserId(), 'icon-user-default.webp') : '';

// Ermittlung der aktiven Route für die Button-Highlights
$requestUri = $_SERVER['REQUEST_URI'] ?? '/';
$path = \parse_url($requestUri, \PHP_URL_PATH);
$path = \trim((string) $path, '/');
if (\str_ends_with($path, '.php')) {
    $path = \substr($path, 0, -4);
}
$currentPage = $path === '' ? 'admin' : $path;
?>

<nav class="c-header-nav">
