<?php

use App\Contracts\Storage\RoleRepositoryInterface;
use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Storage\ImageStorageService;

/**
 * Component: Administrative Header Navigation
 *
 * Beinhaltet das Top-Menü für eingeloggte Administratoren, Profil-Shortcuts und System-Links.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var ImageStorageService $imageStorage
 * @var RoleRepositoryInterface $roleRepository
 * @var array $settings
 * @var array $allReleaseNotes
 */
$roleId = $auth->getRole();
$roleName = $roleId;
if (isset($roleRepository) && $auth->isLoggedIn()) {
    $roles = $roleRepository->loadAll();
    $roleName = isset($roles[$roleId]) ? $roles[$roleId]->name : $roleId;
}
$userImgUrl = isset($imageStorage) ? $imageStorage->getImageUrl('user_images', $auth->getUserId(), 'icon-user-default.webp') : ''; ?>

<nav class="c-header-nav"
     style="position: relative; z-index: 100;">
    <div class="c-tab-content-container c-header-nav__container">

        <!-- User Info & Group -->
        <div class="c-header-nav__brand">
            <div class="c-user-pill">
                <span class="u-font-bold u-text-sm u-flex u-align-center u-gap-s">
                    <img src="<?php echo $userImgUrl; ?>"
                         style="inline-size: 28px; block-size: 24px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-border);"
                         alt="User Avatar">
                    <a href="profile" style="text-decoration: none; color: inherit;" title="Zum Profil">
                        <?php echo \htmlspecialchars($auth->getUsername()); ?>
                    </a>
                </span>
                <div class="c-group-badge">
                    <img src="<?php echo $asset->url('assets/img/icons/icon-shield.webp'); ?>"
                         class="c-icon"
                         alt="Role Icon">
                    <span><?php echo \htmlspecialchars($roleName); ?></span>
                </div>
            </div>

            <!-- User-Management über Permission absichern -->
            <?php if ($auth->hasPermission('system.manage')) { ?>
                <a href="users" class="c-tabs__btn">
                    <img src="<?php echo $asset->url('assets/img/icons/icon-user.webp'); ?>" class="c-icon" alt=""> Rechteverwaltung
                </a>
            <?php } ?>

            <!-- Dashboard über Permission absichern -->
            <?php if ($auth->hasPermission('admin.access')) { ?>
                <a href="admin" class="c-tabs__btn">
                    <img src="<?php echo $asset->url('assets/img/icons/nav-stats.webp'); ?>" class="c-icon" alt=""> Dashboard
                </a>
            <?php } ?>
            <a href="check" class="c-tabs__btn" target="_blank">
                <img src="<?php echo $asset->url('assets/img/icons/action-search.webp'); ?>" class="c-icon" alt=""> Check
            </a>
        </div>

        <!-- Rechtsbündige Tools (Timer, What's New, Logout) -->
        <div class="u-flex u-align-center u-gap-m u-flex-wrap">

            <!-- Der "Was ist neu" Button (Nur sichtbar wenn wir auf der Dashboard Action sind und Notes existieren) -->
            <?php if (!empty($allReleaseNotes)) { ?>
                <button type="button"
                        class="js-show-all-release-notes">
                    🎁 Was ist neu?
                </button>
            <?php } ?>

            <div class="c-session-pill"
                 title="Automatische Abmeldung bei Inaktivität">
                ⏳ <span id="ui-session-timer">20:00</span>
            </div>

            <!-- Logout -->
            <button type="button"
                    id="btn-session-logout"
                    class="c-button c-button--danger-outline u-text-sm"
                    style="padding-inline: 12px; block-size: 34px;">
                ✕ Abmelden
            </button>
        </div>
    </div>
</nav>

<div id="session-warning-modal"
     class="c-modal">
    <div class="c-modal__dialog">
        <h3 class="c-modal__title">
            <span class="u-text-xl">⚠️</span> Inaktivität erkannt
        </h3>
        <p class="u-color-muted"
           style="line-height: 1.5;">Aus Sicherheitsgründen werden Sie in <br><strong id="modal-session-countdown"
