                                    </td>

                                    <!-- 6. Verwaltung (Buttons & Verstecktes Formular) -->
                                    <td class="u-text-right u-padding-right-m">
                                        <div class="u-flex u-gap-xs u-justify-end u-text-nowrap">
                                            <?php if ($auth->hasPermission('permits.print')) { ?>
                                                <a href="admin_print?code=<?php echo $permit->code; ?>" target="_blank" class="c-button c-button--secondary c-button--small c-button--icon-only" title="Druckvorschau">
                                                    <img src="<?php echo $asset->url('assets/img/icons/action-print.webp'); ?>" class="c-icon" alt="Drucken">
                                                </a>
                                            <?php } ?>
                                            <?php if ($auth->hasPermission('permits.view')) { ?>
                                                <a href="check?code=<?php echo $permit->code; ?>" target="_blank" class="c-button c-button--secondary c-button--small c-button--icon-only" title="Details">
                                                    <img src="<?php echo $asset->url('assets/img/icons/action-view.webp'); ?>" class="c-icon" alt="Details">
                                                </a>
                                            <?php } ?>

                                            <?php if ($auth->hasPermission('permits.suspend')) { ?>
                                                <?php if ($is_suspended) { ?>
                                                    <form method="POST"
                                                          action="<?php echo $settings['base_url']; ?>unsuspend_permit"
                                                          class="u-margin-none">
                                                        <input type="hidden"
                                                               name="csrf_token"
                                                               value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>">
                                                        <input type="hidden"
                                                               name="code"
                                                               value="<?php echo $permit->code; ?>">
                                                        <input type="hidden"
                                                               name="action"
                                                               value="unsuspend_permit">
                                                        <button type="submit"
                                                                class="c-button c-button--success c-button--small c-button--icon-only"
                                                                title="Wieder freigeben">
                                                            <img src="<?php echo $asset->url('assets/img/icons/action-unlock.webp'); ?>"
                                                                 class="c-icon"
                                                                 alt="">
                                                        </button>
                                                    </form>
                                                <?php } else { ?>
                                                    <!-- Button zum Sperren -->
                                                    <button class="c-button c-button--danger c-button--small c-button--icon-only js-suspend-btn"
                                                            data-code="<?php echo $permit->code; ?>"
                                                            title="Sperren">
                                                        <img src="<?php echo $asset->url('assets/img/icons/status-denied.webp'); ?>"
                                                             class="c-icon"
                                                             alt="">
                                                    </button>

                                                    <!-- FORMULAR FÜR DIE SPERRE -->
                                                    <form id="form_suspend_<?php echo $permit->code; ?>"
                                                          method="POST"
                                                          action="<?php echo $settings['base_url']; ?>suspend_permit"
                                                          class="u-hidden">
                                                        <input type="hidden"
                                                               name="csrf_token"
                                                               value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>">
                                                        <input type="hidden"
                                                               name="code"
                                                               value="<?php echo $permit->code; ?>">
                                                        <input type="hidden"
                                                               name="action"
                                                               value="suspend_permit">
                                                        <input type="hidden"
                                                               name="reason"
                                                               id="reason_suspend_<?php echo $permit->code; ?>">
                                                    </form>
                                                <?php } ?>
                                            <?php } ?>
                                        </div>
                                    </td>
                                </tr>
                            <?php } ?>
                        <?php } ?>
                    </tbody>
                </table>
            </div>

            <?php echo $paginationHtml; ?>
        </section>
    </div>
<?php } ?>
