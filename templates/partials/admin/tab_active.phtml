<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Config\Config;

/**
 * Partial: Dashboard Tab - Active Permits
 *
 * Übersicht aller aktuell laufenden Genehmigungen.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var array $permitGroups
 * @var array $settings
 * @var string $appRoot
 */
$now = new \DateTimeImmutable('today');
$allActive = $permitGroups['active'] ?? [];

// Sortierung - Am kürzesten gültig zuerst! (bis ASC)
\usort($allActive, fn ($a, $b) => $a->getValidUntil() <=> $b->getValidUntil());

// Paginierungs-Logik
$limit = $itemsPerPage ?? 25;
$page = $currentPage ?? 1;
$totalCount = \count($allActive);
$totalPages = \max(1, (int) \ceil($totalCount / $limit));
$page = \min($page, $totalPages);
$offset = ($page - 1) * $limit;

$activePermits = \array_slice($allActive, $offset, $limit);

\ob_start();
$paginationParam = 'page';
include $appRoot . '/templates/partials/admin/pagination.phtml';
$paginationHtml = \ob_get_clean();

if ($auth->hasPermission('permits.view')) {
    ?>
    <div class="c-tab-content-container">
        <section class="c-card">
            <header class="c-card__header u-flex u-justify-between u-align-center">
                <div>
                    <h3 class="u-margin-block-none">
                        <img src="<?php echo $asset->url('assets/img/icons/status-active.webp'); ?>"
                             class="c-icon"
                             alt=""> Aktive Genehmigungen
                    </h3>
                    <p class="u-color-muted u-text-sm u-margin-block-none">Alle aktuell gültigen Einfahrtsberechtigungen
                        im System.</p>
                </div>
                <span class="c-badge c-badge--success">LIVE: <?php echo \count($allActive); ?></span>
            </header>

