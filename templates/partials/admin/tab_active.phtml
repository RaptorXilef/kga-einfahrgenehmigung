                                        <td class="c-table__data-cell"
                                            data-sort-val="<?php echo \htmlspecialchars($permit->getOwnerEmail()); ?>">
                                            <?php if ($permit->getOwnerEmail()) { ?>
                                                <div class="u-flex u-align-center u-gap-xs">
                                                    <img src="<?php echo $asset->url('assets/img/icons/icon-envelope.webp'); ?>"
                                                         class="c-icon c-icon--inline"
                                                         alt="">
                                                    <small>
                                                        <a href="mailto:<?php echo \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8'); ?>" class="u-text-link c-table__mail-link">
                                                            <?php echo \str_replace('@', '<wbr>@', \htmlspecialchars($permit->getOwnerEmail(), \ENT_QUOTES, 'UTF-8')); ?>
                                                        </a>
                                                    </small>
                                                </div>
                                            <?php } else { ?>
                                                <small class="u-color-muted"><em>Keine E-Mail</em></small>
                                            <?php } ?>
                                        </td>
                                    <?php } ?>

                                    <!-- 4. Zeitraum & Countdown -->
                                    <td class="c-table__data-cell u-text-center"
                                        data-sort-val="<?php echo $permit->getValidFrom()->format('Y-m-d'); ?>">
                                        <div>
                                            <strong class="u-color-main u-text-sm"><?php echo $permit->getValidFrom()->format('d.m.Y'); ?></strong><br>
                                            <small class="u-color-muted">bis <?php echo $permit->getValidUntil()->format('d.m.Y'); ?></small>
                                            <div class="u-margin-block-start-xs">
