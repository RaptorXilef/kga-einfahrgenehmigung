                                    <!-- 2. Fahrzeug (Icon & Nummernschild-Kasten) -->
                                    <td class="c-table__data-cell u-text-center"
                                        data-sort-val="<?php echo \htmlspecialchars($permit->getLicensePlate()); ?>">
                                        <div>
                                            <img src="<?php echo $settings['base_url'] . $iconPath; ?>"
