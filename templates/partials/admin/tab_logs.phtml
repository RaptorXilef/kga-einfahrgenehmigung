<?php

use App\Contracts\System\AssetHelperInterface;
use App\Core\Service\AuthService;
use App\Infrastructure\Config\Config;

/**
 * Partial: Dashboard Tab - Mail Logs
 *
 * Protokoll und Status-Anzeige des SMTP-Versands, inkl. Resend-Option.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var array $mailLogs
 * @var array $settings
 */

// Limit aus der Config holen
$displayLimit = (int) $config->get('mail_log_display_limit', 50);
$logs = \array_slice($mailLogs, 0, $displayLimit);
?>
<?php if ($auth->hasPermission('system.logs.view')) { ?>
    <div class="c-tab-content-container">
        <section class="c-card">
            <header class="c-card__header u-flex u-justify-between u-align-center">
                <div>
                    <h3 class="u-margin-none"><img src="<?php echo $asset->url('assets/img/icons/nav-logs.webp'); ?>"
                             class="c-icon"
                             alt=""> E-Mail Versand-Log</h3>
                    <p class="u-color-muted u-text-sm u-margin-none u-margin-top-xs">Verlauf der letzten <?php echo $displayLimit; ?>
                        System-Nachrichten.</p>
                </div>
                <span class="c-badge c-badge--outline">EINTRÄGE: <?php echo \count($logs); ?></span>
            </header>

            <div class="c-card__body u-padding-none u-overflow-x-auto">
                <table class="c-table u-width-100">
                    <thead>
                        <tr>
                            <th class="u-text-left">Zeitpunkt</th>
                            <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                                <th class="u-text-left">Empfänger</th>
                            <?php } ?>
                            <th class="u-text-left">Betreff & Details</th>
                            <th class="u-text-right u-padding-right-m">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (empty($logs)) { ?>
                            <tr>
                                <td colspan="4"
                                    class="u-text-center u-padding-around-l u-color-muted">
                                    Keine Mail-Logs im System gefunden.
                                </td>
                            </tr>
                        <?php } else { ?>
                            <?php foreach ($logs as $log) {
                                $isSuccess = $log->isSuccess();
                                ?>
                                <tr class="u-hover-fade <?php echo !$isSuccess ? 'c-table__row--danger' : ''; ?>">
                                    <!-- 1. Zeitpunkt -->
                                    <td style="vertical-align: middle;"
                                        class="u-text-nowrap">
                                        <div style="line-height: 1.2;">
                                            <span class="u-text-sm u-color-main u-font-semibold"><?php echo $log->timestamp->format('d.m.Y'); ?></span><br>
                                            <small class="u-color-muted"><?php echo $log->timestamp->format('H:i'); ?> Uhr</small>
                                        </div>
                                    </td>

                                    <!-- 2. Empfänger -->
                                    <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                                        <td style="vertical-align: middle;">
                                            <div class="u-flex u-align-center u-gap-xs">
                                                <img src="<?php echo $asset->url('assets/img/icons/icon-user.webp'); ?>"
                                                     class="c-icon c-icon--inline"
                                                     alt="">
                                                <span class="u-font-bold u-text-sm" style="word-break: break-all;">
                                                    <?php echo \htmlspecialchars($log->recipient); ?>
                                                </span>
                                            </div>
                                        </td>
                                    <?php } ?>

                                    <!-- 3. Betreff & Fehlermeldung -->
                                    <td style="vertical-align: middle;">
                                        <div class="u-margin-bottom-xs">
                                            <strong class="u-color-main u-text-sm"><?php echo \htmlspecialchars($log->subject); ?></strong>
                                        </div>
                                        <div class="u-flex u-align-center u-gap-s">
                                            <code class="c-badge c-badge--outline u-font-mono u-text-xs"><?php echo \htmlspecialchars($log->template, \ENT_QUOTES, 'UTF-8'); ?></code>
                                        </div>

                                        <!-- FEHLERANZEIGE (Nur wenn Status nicht Erfolg) -->
                                        <?php if (!$isSuccess && !empty($log->status)) { ?>
                                            <div class="c-box c-box--danger-soft u-margin-top-s u-padding-around-s">
                                                <div
                                                     class="u-color-danger u-text-xs u-font-extrabold u-text-uppercase u-margin-bottom-xs">
                                                    Fehlermeldung:</div>
                                                <div class="u-text-xs u-color-main"
                                                     style="white-space: normal;"><?php echo \htmlspecialchars($log->status); ?></div>
                                            </div>
                                        <?php } ?>
                                    </td>

                                    <td class="u-text-right u-padding-right-m"
                                        style="vertical-align: middle;">
                                        <div class="u-flex u-gap-xs u-justify-end u-align-center u-text-nowrap">
                                            <span class="c-badge c-badge--<?php echo $isSuccess ? 'success' : 'danger'; ?>" style="min-inline-size: 100px; block-size: 32px;">
                                                <?php $statusIcon = $isSuccess ? 'status-success' : 'status-invalid'; ?>
                                                <img src="<?php echo $asset->url("assets/img/icons/{$statusIcon}.webp"); ?>" class="c-icon" alt="">
                                                <?php echo $isSuccess ? 'GESENDET' : 'FEHLER'; ?>
                                            </span>
                                            <form method="POST"
                                                  action="<?php echo $settings['base_url']; ?>resend_mail"
                                                  class="u-margin-none"
                                                  data-confirm="Möchten Sie diese E-Mail wirklich erneut versenden?">
                                                <input type="hidden"
                                                       name="csrf_token"
                                                       value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>">
                                                <input type="hidden"
                                                       name="timestamp"
                                                       value="<?php echo $log->timestamp->format('Y-m-d H:i:s'); ?>">
                                                <button type="submit"
                                                        class="c-button c-button--primary c-button--icon-only"
                                                        title="Erneut senden">🔄</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <?php } ?>
                        <?php } ?>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
<?php } ?>
