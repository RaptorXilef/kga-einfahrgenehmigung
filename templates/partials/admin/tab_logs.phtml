<?php

use App\Contracts\System\AssetHelperInterface;
use App\Infrastructure\Config\Config;
use App\Modules\Identity\Application\Services\AuthService;

/**
 * Partial: Dashboard Tab - Mail Logs
 *
 * Protokoll und Status-Anzeige des SMTP-Versands, inkl. Resend-Option.
 *
 * @var AssetHelperInterface $asset
 * @var AuthService $auth
 * @var Config $config
 * @var array $mailLogs
 * @var array $settings
 * @var string $appRoot
 */
$allLogs = $mailLogs ?? [];

// Paginierungs-Logik: Schützt vor Parameter-Bleeding aus anderen Tabs
$limit = $itemsPerPage ?? 25;
$focus = $_GET['focus'] ?? 'tab-active';
$page = ($focus === 'tab-logs') ? ($currentPage ?? 1) : 1;

$totalCount = \count($allLogs);
$totalPages = \max(1, (int) \ceil($totalCount / $limit));
$page = \min($page, $totalPages);
$offset = ($page - 1) * $limit;

$logs = \array_slice($allLogs, $offset, $limit);

\ob_start();
$paginationParam = 'page';
$tabFocusId = 'tab-logs';
include $appRoot . '/templates/partials/admin/pagination.phtml';
$paginationHtml = \ob_get_clean();

if ($auth->hasPermission('system.logs.view')) { ?>
<div class="c-tab-content-container">
    <section class="c-card">
        <header class="c-card__header u-flex u-justify-between u-align-center">
            <div>
                <h3 class="u-margin-block-none">
                    <img
                        src="<?php echo $asset->url('assets/img/icons/logs.webp'); ?>"
                        class="c-icon"
                        loading="lazy"
                        alt=""
                    > E-Mail Versand-Log
                </h3>
                <p class="u-color-muted u-text-sm u-margin-block-none u-margin-block-start-xs">Verlauf der letzten
                    System-Nachrichten.</p>
            </div>
            <span class="c-badge c-badge--outline">EINTRÄGE: <?php echo \count($allLogs); ?></span>
        </header>

        <?php echo $paginationHtml; ?>

        <div class="c-card__body u-padding-block-none u-padding-inline-none u-overflow-x-auto">
            <table class="c-table u-inline-size-100">
                <thead>
                    <tr>
                        <th class="c-table__header-cell u-text-start">Zeitpunkt</th>
                        <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                        <th class="c-table__header-cell u-text-start">Empfänger</th>
                        <?php } ?>
                        <th class="c-table__header-cell u-text-start">Betreff & Details</th>
                        <th class="c-table__header-cell u-text-end u-padding-inline-end-m">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <?php if (empty($logs)) { ?>
                    <tr>
                        <td
                            colspan="4"
                            class="c-table__data-cell u-text-center u-padding-around-l u-color-muted"
                        >
                            Keine Mail-Logs im System gefunden.
                        </td>
                    </tr>
                    <?php } else { ?>
                    <?php foreach ($logs as $log) {
                                $isSuccess = $log->isSuccess();
                                ?>
                    <tr class="u-hover-fade <?php echo !$isSuccess ? 'c-table__row--danger' : ''; ?>">
                        <!-- 1. Zeitpunkt -->
                        <td class="c-table__data-cell u-text-nowrap">
                            <div class="u-flex u-flex-column">
                                <span
                                    class="u-text-sm u-color-main u-font-semibold"><?php echo $log->timestamp->format('d.m.Y'); ?></span>
                                <small class="u-color-muted"><?php echo $log->timestamp->format('H:i'); ?> Uhr</small>
                            </div>
                        </td>
                        <!-- 2. Empfänger -->
                        <?php if ($auth->hasPermission('privacy.emails.view')) { ?>
                        <td class="c-table__data-cell">
                            <div class="u-flex u-align-center u-gap-xs">
                                <img
                                    src="<?php echo $asset->url('assets/img/icons/envelope.webp'); ?>"
                                    class="c-icon c-icon--inline"
                                    loading="lazy"
                                    alt=""
                                >
                                <span class="u-font-bold u-text-sm">
                                    <?php echo \str_replace('@', '<wbr>@', \htmlspecialchars($log->recipient)); ?>
                                </span>
                            </div>
                        </td>
                        <?php } ?>
                        <!-- 3. Betreff & Fehlermeldung -->
                        <td class="c-table__data-cell">
                            <div class="u-margin-block-end-xs">
                                <strong
                                    class="u-color-main u-text-sm"><?php echo \htmlspecialchars($log->subject); ?></strong>
                            </div>
                            <div class="u-flex u-align-center u-gap-s">
                                <code class="c-badge c-badge--outline u-font-mono u-text-xs"><?php echo \htmlspecialchars($log->template->value, \ENT_QUOTES, 'UTF-8'); ?></code>
                            </div>
                            <!-- FEHLERANZEIGE (Nur wenn Status nicht Erfolg) -->
                            <?php if (!$isSuccess && !empty($log->status)) { ?>
                            <div class="c-box c-box--danger-soft u-margin-block-start-s u-padding-around-s">
                                <div
                                    class="u-color-danger u-text-xs u-font-extrabold u-text-uppercase u-margin-block-end-xs">
                                    Fehlermeldung:</div>
                                <div class="u-text-xs u-color-main u-white-space-normal">
                                    <?php echo \htmlspecialchars($log->status); ?>
                                </div>
                            </div>
                            <?php } ?>
                        </td>
                        <td class="c-table__data-cell u-text-end u-padding-inline-end-m">
                            <div class="u-flex u-gap-xs u-justify-end u-align-center u-text-nowrap">
                                <span
                                    class="c-badge c-badge--<?php echo $isSuccess ? 'success' : 'danger'; ?> c-badge--fixed"
                                >
                                    <?php $statusIcon = $isSuccess ? 'success' : 'error'; ?>
                                    <img
                                        src="<?php echo $asset->url("assets/img/icons/{$statusIcon}.webp"); ?>"
                                        class="c-icon"
                                        loading="lazy"
                                        alt=""
                                    >
                                    <?php echo $isSuccess ? 'GESENDET' : 'FEHLER'; ?>
                                </span>

                                <?php if (($settings['debug_mode'] ?? false) === true && !empty($log->data['_debug_file'])) { ?>
                                <a
                                    href="<?php echo $settings['base_url']; ?>debug_mail?file=<?php echo \htmlspecialchars($log->data['_debug_file']); ?>"
                                    target="_blank"
                                    class="c-button c-button--secondary c-button--icon-only"
                                    title="Lokale E-Mail-Vorschau im Browser öffnen"
                                >
                                    <img
                                        src="<?php echo $asset->url('assets/img/icons/search.webp'); ?>"
                                        class="c-icon c-button__icon"
                                        loading="lazy"
                                        alt=""
                                    >
                                </a>
                                <?php } ?>

                                <form
                                    method="POST"
                                    action="<?php echo $settings['base_url']; ?>resend_mail"
                                    class="u-margin-block-none"
                                    data-confirm="Möchten Sie diese E-Mail wirklich erneut versenden?"
                                >
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        value="<?php echo $_SESSION['csrf_token'] ?? ''; ?>"
                                    >
                                    <input
                                        type="hidden"
                                        name="timestamp"
                                        value="<?php echo $log->timestamp->format('Y-m-d H:i:s'); ?>"
                                    >
                                    <button
                                        type="submit"
                                        class="c-button c-button--primary c-button--icon-only"
                                        title="Erneut senden"
                                    >
                                        <img
                                            src="<?php echo $asset->url('assets/img/icons/sync.webp'); ?>"
                                            class="c-icon c-button__icon"
                                            loading="lazy"
                                            alt=""
                                        >
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <?php } ?>
                    <?php } ?>
                </tbody>
            </table>
        </div>

        <?php echo $paginationHtml; ?>

    </section>
</div>
