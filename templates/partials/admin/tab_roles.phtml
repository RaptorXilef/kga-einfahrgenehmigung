    /**
     * Rekursive Funktion zum Rendern des Permission-Baums
     */
    if (!\function_exists('renderPermissionNode')) {
        function renderPermissionNode(array $nodes, array $rolePerms, int $depth = 0): void
        {
            foreach ($nodes as $id => $node) {
                $key = $node['key'] ?? null;
                $isAllowed = $key ? \in_array($key, $rolePerms, true) : false;
                $hasChildren = !empty($node['children']);
                ?>
                <div class="p-tree-node"
                     style="--depth: <?php echo $depth; ?>;"
                     data-key="<?php echo $key ?? $id; ?>">
                    <div class="p-item <?php echo $depth === 0 ? 'is-root' : ''; ?> <?php echo !$key ? 'is-category' : ''; ?>">
                        <div class="p-label u-flex u-flex-column">
                            <span class="p-label-main <?php echo $depth === 0 ? 'p-label-main--root' : ''; ?>">
                                <?php echo \htmlspecialchars((string) ($node['label'] ?? $id)); ?>
                            </span>
                            <?php if ($key) { ?>
                                <span class="p-label-sub">
                                    <?php echo \htmlspecialchars((string) $key); ?>
                                </span>
                            <?php } else { ?>
                                <span class="p-label-sub p-label-sub--category">
                                    Kategorie
                                </span>
                            <?php } ?>
                        </div>
                        <div class="p-controls">
                            <?php if ($key) { ?>
                                <label class="c-switch">
                                    <input type="checkbox"
                                           name="perms[]"
                                           value="<?php echo \htmlspecialchars((string) $key); ?>"
                                           data-perm-check="true"
                                           data-key="<?php echo \htmlspecialchars((string) $key); ?>"
                                           <?php echo $isAllowed ? 'checked' : ''; ?>>
                                    <span class="c-switch-label" data-on="ALLOW" data-off="NONE"></span>
                                </label>
                            <?php } ?>
                        </div>
                    </div>
                    <?php if ($hasChildren) {
                        \renderPermissionNode($node['children'], $rolePerms, $depth + 1);
                    } ?>
                </div>
    <?php
            }
        }
    } ?>

