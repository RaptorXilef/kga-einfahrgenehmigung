<?php

/**
 * Component: Cookie / Consent Banner
 * Steuert die DSGVO-konforme Einwilligung für Tracking (Google Analytics 4).
 *
 * @var string $cspNonce
 */

// Lade die Consent-Konfiguration (Fallback auf root_path, falls $appRoot nicht existiert)
$root = $appRoot ?? \dirname(__DIR__, 2);
$consentConfigPath = $root . '/config/consent.php';

if (!\file_exists($consentConfigPath)) {
    return;
}
$consentConfig = include $consentConfigPath;

if (empty($consentConfig['enabled'])) {
    return;
}

$baseUrl = $settings['base_url'] ?? '/';
$gaId = $settings['ga4_server_side']['measurement_id'] ?? '';
?>

<div id="kga-consent-banner"
     class="c-consent-banner js-consent-banner"
     style="display: none;">
    <div class="o-container o-container--large">

        <script type="application/json"
                id="consent-config"
                nonce="<?php echo $cspNonce; ?>">
        <?php echo \json_encode([
            'gaId' => $gaId,
            'texts' => $consentConfig['texts'],
        ], \JSON_HEX_TAG | \JSON_HEX_AMP | \JSON_HEX_APOS | \JSON_HEX_QUOT); ?>

        </script>

        <div class="c-consent-banner__dialog">
            <div class="c-consent-banner__content">
                <h3 class="c-consent-banner__title"><?php echo \htmlspecialchars($consentConfig['texts']['title']); ?></h3>
                <p class="c-consent-banner__text">
                    <?php echo \htmlspecialchars($consentConfig['texts']['description']); ?>
                </p>

                <div class="c-consent-banner__links">
                    <a href="<?php echo \htmlspecialchars($baseUrl); ?>datenschutz" class="u-text-link u-margin-right-xs">
                        <?php echo \htmlspecialchars($consentConfig['texts']['link_datenschutz']); ?>
                    </a>
                    <a href="<?php echo \htmlspecialchars($baseUrl); ?>impressum" class="u-text-link">
                        <?php echo \htmlspecialchars($consentConfig['texts']['link_impressum']); ?>
                    </a>
                </div>

                <div id="kga-consent-details"
                     class="c-consent-banner__details js-consent-details"
                     style="display: none;">
                    <?php foreach ($consentConfig['groups'] as $group) { ?>
                        <div class="c-consent-banner__group">
                            <div class="c-form-checkbox__wrapper">
                                <input type="checkbox"
                                       id="consent-chk-<?php echo $group['id']; ?>"
                                       value="1"
                                       class="c-form-checkbox"
                                       <?php echo $group['required'] ? 'checked disabled' : ''; ?>>
                                <div>
                                    <strong class="u-display-block u-text-sm"><?php echo \htmlspecialchars($group['title']); ?></strong>
                                    <span class="u-text-xs u-color-muted"><?php echo \htmlspecialchars($group['description']); ?></span>
                                </div>
                            </div>
                        </div>
                    <?php } ?>
                </div>
            </div>

            <div class="c-consent-banner__actions">
                <button class="c-consent-banner__button c-consent-banner__button--primary js-accept-all">
                    <?php echo \htmlspecialchars($consentConfig['texts']['accept_all']); ?>
                </button>
                <button class="c-consent-banner__button c-consent-banner__button--secondary js-accept-essential">
                    <?php echo \htmlspecialchars($consentConfig['texts']['accept_essential']); ?>
                </button>
                <button id="btn-toggle-details"
                        class="c-consent-banner__button c-consent-banner__button--text js-toggle-details">
                    <?php echo \htmlspecialchars($consentConfig['texts']['show_details']); ?>
                </button>
                <button id="btn-save-selection"
                        class="c-consent-banner__button c-consent-banner__button--secondary js-save-selection"
                        style="display: none;">
                    <?php echo \htmlspecialchars($consentConfig['texts']['save_selection']); ?>
                </button>
            </div>
        </div>
    </div>
</div>
