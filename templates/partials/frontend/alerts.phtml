<?php

/** @var array $flashes */
if (!empty($flashes)) {
    ?>
    <div class="u-margin-block-end-l">
        <?php foreach ($flashes as $type => $messages) { ?>
            <?php
                // Maps flash type to BEM modifier
                $modifier = match ($type) {
                    'error' => 'danger',
                    'success' => 'success',
                    'warning' => 'warning',
                    default => 'info',
                };
            ?>
            <?php foreach ($messages as $msg) { ?>
                <div class="c-alert c-alert--<?php echo $modifier; ?> u-margin-block-end-s">
                    <div class="c-alert__content">
                        <?php echo \strip_tags($msg, '<div><span><strong><em><b><i><br><ul><li>'); ?>
                    </div>
                </div>
            <?php } ?>
        <?php } ?>
    </div>
<?php } ?>
