<?php

/**
 * Rendert die vom TemplateRenderer vorbereiteten und bereinigten Flash-Messages.
 * VSA FIX: 100% Dumme View ohne match()-Mapping oder strip_tags()-Aufrufe im Template.
 *
 * @var array<int, array{modifier: string, html: string}> $flashAlerts
 */
if (!empty($flashAlerts)) {
    ?>
<div class="u-margin-block-end-l">
    <?php foreach ($flashAlerts as $alert) { ?>
    <div class="c-alert c-alert--<?php echo $alert['modifier']; ?> u-margin-block-end-s">
        <div class="c-alert__content">
            <?php echo $alert['html']; ?>
        </div>
    </div>
    <?php } ?>
</div>
<?php } ?>
