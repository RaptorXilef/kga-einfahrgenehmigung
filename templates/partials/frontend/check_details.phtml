<?php

use App\Core\Entity\Permit;

/**
 * Snippet: Verification Permit Details
 *
 * Universelle Status-Box für Fahrzeuge und Sperrgründe.
 *
 * @var Permit $permit
 */
?>
<div class="c-box u-text-left u-margin-y-l">
    <div class="u-margin-bottom-m">
        <span class="u-color-muted u-text-xs u-font-bold u-text-uppercase" style="letter-spacing: 1px;">Fahrzeug</span><br>
        <strong class="u-text-lg u-color-dark">
            <?php
            $info = [];
if (!empty($permit->getLicensePlate())) {
    $info[] = \htmlspecialchars($permit->getLicensePlate());
}
if (!empty($permit->getCompany())) {
    $info[] = 'Firma: ' . \htmlspecialchars($permit->getCompany());
}
echo \implode(' / ', $info);
?>
        </strong>
    </div>

    <div class="u-border-top u-padding-top-m <?php echo $permit->isSuspended() ? 'u-margin-bottom-m' : ''; ?>">
        <span class="u-color-muted u-text-xs u-font-bold u-text-uppercase" style="letter-spacing: 1px;">Gültigkeit</span><br>
        <span class="u-text-sm u-color-main">
            Von <strong class="u-font-semibold"><?php echo $permit->getValidFrom()->format('d.m.Y'); ?></strong> bis <strong class="u-font-semibold"><?php echo $permit->getValidUntil()->format('d.m.Y'); ?></strong>
        </span>
    </div>

    <?php if ($permit->isSuspended() && !empty($permit->getSuspensionReason())) { ?>
        <div class="u-border-top u-padding-top-m"
             style="border-block-start-color: var(--color-danger-soft) !important;">
            <span class="u-text-xs u-font-bold u-text-uppercase u-color-danger" style="letter-spacing: 1px;">Sperrgrund</span><br>
            <span class="u-text-sm u-font-semibold u-color-danger">
                <?php echo \htmlspecialchars($permit->getSuspensionReason()); ?>
            </span>
        </div>
    <?php } ?>
</div>
