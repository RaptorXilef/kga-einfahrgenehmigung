<?php

use App\Contracts\System\AssetHelperInterface;
use App\Infrastructure\Config\Config;

/**
 * Component: Test Mode & Debug Mode Indicator (Animated)
 *
 * Zeigt einen globalen Warnbanner, wenn PayPal Sandbox oder der Debug-Modus aktiv sind.
 *
 * @var AssetHelperInterface $asset
 * @var Config $config
 * @var array $settings
 */
?>
<?php if ($config->isTestMode()) { ?>
    <div class="c-test-indicator">
        <div class="o-container o-container--large c-test-indicator__content">

            <div class="c-test-indicator__badge">
                <img src="<?php echo $asset->url('assets/img/icons/warning.webp'); ?>"
                     class="c-icon"
                     loading="lazy"
                     alt=""> Test-System
            </div>

            <div class="c-test-indicator__text">
                PayPal Sandbox aktiv &bull; Test-E-Mail:
                <code><?php echo \htmlspecialchars($config->get('mail')['recipients']['test'] ?? 'test@example.com'); ?></code>
            </div>

            <?php if ($config->get('debug_mode', false) === true) { ?>
                <div class="c-test-indicator__admin-badge">
                    <img src="<?php echo $asset->url('assets/img/icons/tools.webp'); ?>"
                         class="c-icon c-button__icon"
                         loading="lazy"
                         alt=""> Debug-Modus aktiv
                </div>
            <?php } ?>

        </div>
    </div>
<?php } ?>
