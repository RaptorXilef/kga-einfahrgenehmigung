<?php

use App\Contracts\System\JsonHelperInterface;

/**
 * Component: Global Dynamic Footer
 *
 * Liest die Version aus der package.json und zeigt Urheberrechts- und GitHub-Informationen.
 *
 * @var JsonHelperInterface $jsonHelper
 * @var string|null $appRoot (optional, wird berechnet falls nicht vorhanden)
 */

// 1. App-Root Fallback (falls die Variable mal nicht übergeben wird)
$root = $appRoot ?? \dirname(__DIR__, 2);

// 2. Versionsnummer aus der package.json auslesen
$version = 'v0.0.0';
$packageJsonPath = $root . '/package.json';

if (\file_exists($packageJsonPath) && isset($jsonHelper)) {
    try {
        $pkgData = $jsonHelper->read($packageJsonPath);
        if (\is_array($pkgData) && isset($pkgData['version'])) {
            $version = 'v' . $pkgData['version'];
        }
    } catch (\RuntimeException $e) {
        // Fallback
    }
}

// 3. Copyright-Jahr Logik (Zeigt "2026" oder "2026 - 2027")
$startYear = 2026;
$currentYear = (int) \date('Y');
$yearDisplay = $currentYear > $startYear ? "{$startYear} - {$currentYear}" : (string) $startYear;

// 4. Software Details
$developerName = 'Felix Maywald';
$softwareName = 'KGA-Einfahrts-Manager';
$githubUrl = 'https://github.com/RaptorXilef/kga-einfahrgenehmigung';
$issuesUrl = $githubUrl . '/issues';

// 5. Rechtliche Links berechnen
$baseUrl = $settings['base_url'] ?? '/';
$impressumUrl = \rtrim($baseUrl, '/') . '/impressum';
$datenschutzUrl = \rtrim($baseUrl, '/') . '/datenschutz';
?>

<footer class="c-footer">
    <div class="c-footer__content">
        <div class="c-footer__copyright">
            &copy; <?php echo $yearDisplay; ?> <?php echo \htmlspecialchars($softwareName); ?>

            <?php if (isset($auth) && $auth->isLoggedIn() && $auth->hasPermission('admin.access')) { ?>
                <a href="<?php echo \htmlspecialchars($baseUrl); ?>changelog"
                   class="c-footer__version c-footer__version--admin"
                   title="Versionshistorie / Changelog ansehen">
                    <?php echo \htmlspecialchars($version); ?>
                </a>
            <?php } else { ?>
                <span class="c-footer__version">
                    <?php echo \htmlspecialchars($version); ?>
                </span>
            <?php } ?>
        </div>

        <?php
        // Bug-Report-Link nur für eingeloggte Admins mit Dashboard-Rechten sichtbar machen
        if (isset($auth) && $auth->isLoggedIn() && $auth->hasPermission('admin.access')) { ?>
            <div class="u-margin-top-xs">
                <a href="<?php echo \htmlspecialchars($issuesUrl); ?>" target="_blank" rel="noopener noreferrer" class="u-text-link u-text-xs">
                    Fehler melden / Bug Report
                </a>
            </div>
        <?php } ?>

        <div class="c-footer__links">
            <a href="<?php echo \htmlspecialchars($impressumUrl); ?>" class="u-text-link">Impressum</a>
            <span class="u-color-muted">&bull;</span>
            <a href="<?php echo \htmlspecialchars($datenschutzUrl); ?>" class="u-text-link">Datenschutzerklärung</a>
        </div>
    </div>
</footer>

<?php include $appRoot . '/templates/partials/frontend/consent_banner.phtml'; ?>
