<?php

/**
 * Component: Global Dynamic Footer
 * VSA FIX: PHTML ist jetzt 100% Dumm. Nutzt bereitgestellte System-Variablen!
 *
 * @var array $settings
 * @var string $appVersion   Bereitgestellt durch TemplateRenderer
 * @var string $currentYear  Bereitgestellt durch TemplateRenderer
 * @var array|null $debugMetrics Bereitgestellt durch TemplateRenderer
 * @var string|null $appRoot (optional, wird berechnet falls nicht vorhanden)
 */

// 1. Copyright-Jahr Logik (Zeigt "2026" oder "2026 - 2027")
$startYear = 2026;
$yearDisplay = (int) $currentYear > $startYear ? "{$startYear} - {$currentYear}" : (string) $startYear;

// TODO URL und Name in Config festlegen
// 2. Software Details
$softwareName = 'KGA-Einfahrts-Manager';
$githubUrl = 'https://github.com/RaptorXilef/kga-einfahrgenehmigung';
$issuesUrl = $githubUrl . '/issues';

// 3. Rechtliche Links berechnen
$baseUrl = $settings['base_url'] ?? '/';
$impressumUrl = \rtrim($baseUrl, '/') . '/impressum';
$datenschutzUrl = \rtrim($baseUrl, '/') . '/datenschutz';
?>

<footer class="c-footer">
    <div class="c-footer__content">
        <div class="c-footer__copyright">
            &copy; <?php echo $yearDisplay; ?> <?php echo \htmlspecialchars($softwareName); ?>

            <?php if (isset($auth) && $auth->isLoggedIn() && $auth->hasPermission('admin.access')) { ?>
            <a
                href="<?php echo \htmlspecialchars($baseUrl); ?>changelog"
                class="c-footer__version c-footer__version--admin"
                title="Versionshistorie / Changelog ansehen"
            >
                <?php echo \htmlspecialchars($appVersion); ?>
            </a>
            <?php } else { ?>
            <span class="c-footer__version">
                <?php echo \htmlspecialchars($appVersion); ?>
            </span>
            <?php } ?>
        </div>

        <?php if (isset($auth) && $auth->isLoggedIn() && $auth->hasPermission('admin.access')) { ?>
        <div class="u-margin-block-start-xs">
            <a
                href="<?php echo \htmlspecialchars($issuesUrl); ?>"
                target="_blank"
                rel="noopener noreferrer"
                class="u-text-link u-text-xs"
            >
                Fehler melden / Bug Report
            </a>
        </div>
        <?php } ?>

        <div class="c-footer__links">
            <a
                href="<?php echo \htmlspecialchars($impressumUrl); ?>"
                class="u-text-link"
            >Impressum</a>
            <span class="u-color-muted">&bull;</span>
            <a
                href="<?php echo \htmlspecialchars($datenschutzUrl); ?>"
                class="u-text-link"
            >Datenschutzerklärung</a>
        </div>

        <?php if ($debugMetrics !== null) { ?>
        <div class="u-text-center u-margin-block-start-m u-color-muted u-text-xs u-font-mono u-opacity-50">
            ⏱️ <?php echo $debugMetrics['timeMs']; ?> ms &nbsp;|&nbsp; 💾 <?php echo $debugMetrics['memoryMb']; ?> MB
            RAM
        </div>
        <?php } ?>
    </div>
</footer>

<?php include $appRoot . '/templates/partials/frontend/consent_banner.phtml'; ?>
