<?php

/**
 * Component: Global Dynamic Footer
 * VSA FIX: PHTML ist 100% dumm und nutzt ausschließlich die vom TemplateRenderer vorbereiteten Variablen.
 *
 * @var array $settings
 * @var string $appRoot
 * @var string $appVersion
 * @var string $footerYearDisplay
 * @var string $footerSoftwareName
 * @var string $footerIssuesUrl
 * @var string $footerImpressumUrl
 * @var string $footerDatenschutzUrl
 * @var array|null $debugMetrics
 * @var bool $canAccessAdmin
 */
?>

<footer class="c-footer">
    <div class="c-footer__content">
        <div class="c-footer__copyright">
            &copy; <?php echo \htmlspecialchars($footerYearDisplay); ?>
            <?php echo \htmlspecialchars($footerSoftwareName); ?>

            <?php if ($canAccessAdmin) { ?>
            <a
                href="<?php echo \htmlspecialchars($settings['base_url']); ?>changelog"
                class="c-footer__version c-footer__version--admin"
                title="Versionshistorie / Changelog ansehen"
            >
                <?php echo \htmlspecialchars($appVersion); ?>
            </a>
            <?php } else { ?>
            <span class="c-footer__version">
                <?php echo \htmlspecialchars($appVersion); ?>
            </span>
            <?php } ?>
        </div>

        <?php if ($canAccessAdmin) { ?>
        <div class="u-margin-block-start-xs">
            <a
                href="<?php echo \htmlspecialchars($footerIssuesUrl); ?>"
                target="_blank"
                rel="noopener noreferrer"
                class="u-text-link u-text-xs"
            >
                Fehler melden / Bug Report
            </a>
        </div>
        <?php } ?>

        <div class="c-footer__links">
            <a
                href="<?php echo \htmlspecialchars($footerImpressumUrl); ?>"
                class="u-text-link"
            >Impressum</a>
            <span class="u-color-muted">&bull;</span>
            <a
                href="<?php echo \htmlspecialchars($footerDatenschutzUrl); ?>"
                class="u-text-link"
            >Datenschutzerklärung</a>
        </div>

        <?php if ($debugMetrics !== null) { ?>
        <div class="u-text-center u-margin-block-start-m u-color-muted u-text-xs u-font-mono u-opacity-50">
            ⏱️ <?php echo $debugMetrics['timeMs']; ?> ms &nbsp;|&nbsp; 💾 <?php echo $debugMetrics['memoryMb']; ?> MB
            RAM
        </div>
        <?php } ?>
    </div>
</footer>

