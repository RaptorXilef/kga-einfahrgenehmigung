# =============================================================================
# PHPStan Konfiguration für High-End Code-Qualität (Phase 7 - Final)
# =============================================================================
# Hinweis: Einfach in YAML formatieren :D

includes:
    # WICHTIG: Bleeding Edge aktiviert die neuesten, striktesten Analysen
    # (z.B. Dead Code Detection) der kommenden PHPStan Version.
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    # - phpstan-baseline.neon # (Einkommentieren, falls eine Baseline generiert wurde)

parameters:
    # Level 0-9
    # Level 5 prüft Typen, erlaubt aber noch etwas Flexibilität.
    # Level 9 wäre "Maximaler Schmerz" (nur für neue Projekte empfohlen).
    # TODO: Noch nicht auf "max" setzen (ohne " )
    level: 0
    # Erstmal 0 um Architekturbrüche zu finden, danach wieder 6

    # Bedeutung: PHPStan prüft im Code standardmäßig sehr streng, wenn du den Typ mixed explizit angibst (z. B.
    # public function foo(mixed $data)). Wenn es auf true steht, verbietet PHPStan fast jede Operation mit mixed,
    # solange du es nicht vorher type-safety-mäßig geprüft hast (is_string, is_array etc.). Auf false schaltet
    # PHPStan diese extrem pingeligen expliziten mixed-Prüfungen ab.
    # TODO Wenn LVL 9 keine Fehler hat wieder aktivieren
    checkExplicitMixed: false

    # Bedeutung: Noch wichtiger: Wenn PHPStan den Typ einer Variablen oder eines Funktions-Returns nicht ermitteln
    # kann (weil z. B. eine Fremdbibliothek keine Typen liefert oder Datenbank-Ergebnisse via PDO geholt werden),
    # stuft PHPStan dies als implicites mixed ein. Auf true wirft PHPStan in Level 9 hunderte Fehlermeldungen. Mit
    # false erlauben wir PHPStan, bei unvollständigen Typ-Informationen (besonders bei dynamischen Array-Mappern und
    # Legacy-Schnittstellen) milder zu urteilen.
    # TODO Wenn LVL 9 keine Fehler hat wieder aktivieren
    checkImplicitMixed: false

    # Welche Ordner sollen analysiert werden?
    paths:
        - src
        # - tests
        - public
        - config
        - database

    scanDirectories:
        - src
        - public

    bootstrapFiles:
        - vendor/autoload.php

    # Exklusionen (Vendor und Node_Modules sollten ignoriert werden)
    excludePaths:
        analyse:
            - tests
            - vendor
            - node_modules
            - public/dist (?)
            - .debug (?)
            - public/dev (?)

    # Wir simulieren eine PHP 8.5 Umgebung (80500), damit PHPStan
    # neue Features bereits jetzt versteht.
    phpVersion: 80500

    # Cache beschleunigt die Analyse massiv
    tmpDir: .cache/phpstan

    # Nutzt alle Kerne (Parallelisierung)
    parallel:
        processTimeout: 300.0

    # Prüft, ob Funktionen Seiteneffekte haben (Clean Code)
    rememberPossiblyImpureFunctionValues: true

    # Meldet, wenn ich einen Fehler ignoriere, der gar nicht mehr existiert (bei true)
    reportUnmatchedIgnoredErrors: false

    # Dies verhindert, dass PHPStan denkt, er wüsste es besser als die Laufzeit,
    # wenn es um native Funktionen geht, die false liefern können.
    treatPhpDocTypesAsCertain: false

    # Bewusste Ausnahmen, die für unsere Architektur notwendig sind
    ignoreErrors:
        # #Construct empty\(\) is not allowed...#: Strict-Rules hassen empty($array).
        # Sie zwingen dich, if ($array === [] || $array === null) zu schreiben.
        #- '#Construct empty\(\) is not allowed. Use more strict comparison.#'

        # #Dynamic call to static method#: Erlaubt dynamische Aufrufe statischer Methoden,
        # was oft in Testing-Frameworks (Pest) oder bei dynamischen Factories vorkommt.
        - '#Dynamic call to static method#'

        # #Cannot cast mixed to int.#: PHPStan warnt, wenn man einen unbekannten Typ (mixed)
        # hart zu einem Integer castet (z.B. bei Array-Daten aus der DB). Wir erzwingen das aber oft bewusst zur Typ-Sicherheit.
        #- '#Cannot cast mixed to int.#'

        # #Variable \$[a-zA-Z0-9_]+ might not be defined.#: In deinen PHTML-Dateien nutzen wir extract($data).
        # PHPStan kann nicht wissen, dass dadurch plötzlich Variablen wie $vereinsName existieren und
        # wirft hunderte Fehlalarme.
        - '#Variable \$[a-zA-Z0-9_]+ might not be defined\.#'

        # #Expression on left side of \?\? is not nullable.#: Wenn PHPStan zu 100% sicher ist,
        # dass $text ein String ist, verbietet es dir zur Sicherheit $text ?? '' zu schreiben.
        # In der Praxis baut man solche Fallbacks (z.B. in PHTMLs) aber gerne zur absoluten Sicherheit ein.
        - '#Expression on left side of \?\? is not nullable\.#'

        # #Variable \$[a-zA-Z0-9_]+ in empty\(\) always exists and is not falsy.#: Manchmal weiß PHPStan durch
        # vorherige Checks schon, dass eine Variable existiert und warnt dann bei redundanten empty() Prüfungen.
        # In PHTMLs als Sicherheitsnetz aber gewollt.
        - '#Variable \$[a-zA-Z0-9_]+ in empty\(\) always exists and is not falsy\.#'

        # #Match expression does not handle remaining value#: Warnt, wenn ein match() nicht alle theoretisch
        # möglichen Werte (mixed) abdeckt. Oft wissen wir aber durch die Domänen-Logik, dass andere Werte nicht auftreten können.
        - '#Match expression does not handle remaining value#'

        # #Short ternary operator is not allowed#: Verbietet die extrem nützliche kurze Schreibweise $a ?: $b und
        # zwingt dich zu $a ? $a : $b. Diese Regel ignorieren wir, um den Code kompakt zu halten.
        - '#Short ternary operator is not allowed#'

        # #Only booleans are allowed in.*#: Strict-Rules verbieten if ($string) oder if ($array).
        # Du müsstest stattdessen zwingend if ($string !== '') schreiben. Das ignorieren wir für bessere Lesbarkeit.
        #- '#Only booleans are allowed in.*#'

        # #Call to function array_filter\(\) requires parameter \#2#: PHPStan möchte, dass man bei array_filter
        # immer eine Callback-Funktion angibt. Wir nutzen es oft ohne, um einfach Leerwerte (null, false, '') aus Arrays zu filtern.
        - '#Call to function array_filter\(\) requires parameter \#2#'

        # #Casting to string something that.*#: Warnt vor überflüssigen String-Casts, wenn die Variable laut PHPStan
        # schon ein String ist. Besonders bei Datenbank-Rückgaben (PDO) ist das aber als Fallback ein guter Schutzmechanismus.
        - '#Casting to string something that.*#'

        # #Path in require\(\).*is not a file or it does not exist#: PHPStan findet manchmal dynamische require-Pfade
        # nicht (z.B. beim Template-Renderer oder Wartungsmodus). Zur Laufzeit existieren sie aber sicher.
        - '#Path in require\(\).*is not a file or it does not exist#'

        # Pest nutzt interne Methoden für seine API, das ist beabsichtigt.
        #- message: '#Call to method .* of internal class Pest\\.* from outside its root namespace Pest#'
        #  path: tests/*

        # Wir ignorieren die strict-rules empty() Meldungen, da sie für die Architektur irrelevant sind
        # TODO Später
        # - '#Construct empty\(\) is not allowed#'

        # #Construct empty() is not allowed...#: Verbietet die Funktion empty().
        # Auf Level 9 verlangen die Strict-Rules strenge Vergleiche (z.B. $val !== null && $val !== '').
        # Da wir empty() in Formularen und Validierungen als kompaktes Sicherheitsnetz nutzen, ignorieren wir das.
        # TODO Später
        - '#Construct empty\(\) is not allowed#'

        # #Only booleans are allowed in if/while...#: Verbietet "Truthy/Falsy"-Abfragen wie if ($string) oder if ($array).
        # Level 9 verlangt exakte Typen (if ($string !== '')). Für kürzere und lesbarere Checks ignorieren wir das.
        - '#Only booleans are allowed in.*#'

        # #Cannot cast mixed to int|string|float|bool# & #Part ... (mixed) of encapsed string cannot be cast to string.#:
        # Verhindert harte Casts ((int), (string) oder Einbettung in Strings "") von Variablen, deren Typ PHPStan nur als 'mixed' bekannt ist
        # (häufig bei PDO-Ergebnissen oder Rohdaten). Da wir hier zur Laufzeit absichern, wird dies ignoriert.
        - '#Cannot cast mixed to (int|string|float|bool)\.#'

        # #Part ... (mixed) of encapsed string cannot be cast to string.#:
        # PHPStan Level 9 verbietet es, Variablen vom Typ 'mixed' (z.B. aus JSON oder Arrays) direkt
        # in doppelte Anführungszeichen einzubetten (String-Interpolation wie "Wert: {$val}"),
        # weil sie nicht garantiert als String vorliegen. Wir erlauben es hier pragmatisch.
        - '#Part .* \(mixed\) of encapsed string cannot be cast to string\.#'

        # #Parameter ... expects ..., mixed given.#: Schlägt an, wenn eine Methode einen festen Typ (z.B. int oder string)
        # verlangt, du aber eine Variable vom Typ 'mixed' (z.B. aus einem Array oder Request) übergibst.
        - '#Parameter .* of .* expects .*, mixed given\.#'

        # #Cannot access offset ... on mixed.# & #Argument of an invalid type mixed supplied for foreach.#:
        # Verhindert den Zugriff auf Array-Schlüssel ($data['key']) oder das Durchlaufen per foreach,
        # wenn PHPStan die Variable fälschlicherweise als 'mixed' statt als Array erkennt.
        - '#Cannot access offset .* on mixed\.#'

        # #Argument of an invalid type mixed supplied for foreach.#:
        # Schlägt an, wenn du eine Variable vom Typ 'mixed' in einer foreach-Schleife durchlaufen möchtest.
        # Level 9 verlangt hier, dass vorher geprüft wird, ob es ein Array oder ein Iterable ist.
        - '#Argument of an invalid type mixed supplied for foreach.*#'

        # #Method ... / Property ... return type / parameter has no value type specified in iterable type array.#:
        # Diese drei Regeln greifen, wenn du irgendwo im Code nur das generische Wort `array` verwendest,
        # anstatt ein typisiertes Array anzugeben (z.B. `array<string, mixed>` oder `list<string>`).
        # Da das bei Legacy-Arrays oder schnellen Mappings zu viel Overhead erzeugt, erstmal weg damit.
        - '#Method .* has parameter .* with no value type specified in iterable type array\.#'
        - '#Method .* return type has no value type specified in iterable type array\.#'
        - '#Property .* type has no value type specified in iterable type array\.#'

    # =========================================================================
    # ARCHITEKTUR: VERBOTENE KLASSEN
    # =========================================================================
    disallowedClasses:
        - class:
              - 'PDO'
              - 'PDOException'
              - 'PDOStatement'
          message: 'Verstoß gegen Clean Architecture: Die native PDO-Klasse darf ausschließlich im Infrastructure-Layer, Container oder in CQRS-Read-Handlern verwendet werden!'
          allowIn:
              - src/SharedKernel/Infrastructure/*
              - src/Modules/*/Infrastructure/*
              - src/Modules/*/Application/UseCases/*
              - src/Bootstrap/*

    # =========================================================================
    # ARCHITEKTUR: VERBOTENE FUNKTIONEN
    # =========================================================================
    disallowedFunctionCalls:
        # 1. Dateisystem-Operationen (I/O)
        - function:
              - 'unlink'
              - 'mkdir'
              - 'rmdir'
              - 'rename'
              - 'copy'
              - 'move_uploaded_file'
              - 'file_put_contents'
              - 'file_get_contents'
              - 'fopen'
              - 'fwrite'
              - 'fputcsv'
              - 'fclose'
          message: 'Verstoß gegen Clean Architecture: Dateisystem-Operationen (I/O) sind hier verboten. Lagere dies in das Infrastructure-Layer aus.'
          allowIn:
              - src/SharedKernel/Infrastructure/*
              - src/Modules/*/Infrastructure/*
              - src/Application/Middleware/JsonBodyParserMiddleware.php
              - src/Application/View/TemplateRenderer.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - src/Application/Routing/ActionRegistry.php
              - src/Bootstrap/*
              - public/*

        # 2. Netzwerk-Operationen (cURL)
        - function:
              - 'curl_init'
              - 'curl_exec'
              - 'curl_setopt'
              - 'curl_setopt_array'
              - 'curl_multi_init'
              - 'curl_multi_add_handle'
              - 'curl_multi_exec'
              - 'curl_getinfo'
              - 'curl_close'
              - 'curl_multi_close'
          message: 'Verstoß gegen Clean Architecture: Netzwerk-Operationen (cURL) sind hier verboten. Nutze einen API-Client im Infrastructure-Layer.'
          allowIn:
              - src/SharedKernel/Infrastructure/*
              - src/Modules/*/Infrastructure/*

        # 3. Bildverarbeitung (GD Library)
        - function:
              - 'imagecreatefromstring'
              - 'imagecreatefromjpeg'
              - 'imagecreatefrompng'
              - 'imagecreatefromwebp'
              - 'imagecreatetruecolor'
              - 'imagecopyresampled'
              - 'imagecrop'
              - 'imagewebp'
              - 'imagejpeg'
          message: 'Verstoß gegen Clean Architecture: Direkte Bildverarbeitung ist hier verboten. Nutze das ImageStorageInterface.'
          allowIn:
              - src/Modules/System/Infrastructure/Storage/ImageStorageService.php

        # 4. Verbot von direkten HTTP- und Session-Manipulationen
        - function:
              - 'header'
              - 'http_response_code'
              - 'setcookie'
              - 'session_start'
              - 'session_destroy'
              - 'session_regenerate_id'
              - 'session_write_close'
              - 'set_time_limit'
          message: 'Verstoß gegen Clean Architecture: Direkte HTTP- oder Session-Manipulation ist verboten. Nutze Response-Objekte oder den SessionManager.'
          allowIn:
              - src/Application/Response/*
              - src/Application/Session/SessionManager.php
              - src/Application/Middleware/SecurityHeadersMiddleware.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - src/Application/FrontendController.php
              - src/Bootstrap/*
              - public/*

        # 5. Verbot von Debug- und Kill-Funktionen
        - function:
              - 'die'
              - 'exit'
              - 'var_dump'
              - 'print_r'
              - 'phpinfo'
          message: 'Verstoß gegen Clean Architecture: Nutze Exceptions für Abbrüche und Logger für Debugging.'
          allowIn:
              - public/dev/*
              - public/index.php
              - src/Application/Response/*
              - src/Application/Exception/GlobalExceptionHandler.php
              - src/Application/FrontendController.php

        # 6. Verbot von System/Exec Funktionen (Sicherheitsrisiko)
        - function:
              - 'exec'
              - 'passthru'
              - 'shell_exec'
              - 'system'
              - 'eval'
          message: 'Sicherheitsrisiko: System- und Eval-Aufrufe sind streng verboten!'

        # 7. Verbot der nativen Mail-Funktion
        - function:
              - 'mail'
          message: 'Verstoß gegen Clean Architecture: Nutze das MailServiceInterface für E-Mails.'

        # 8. Verbot von nativem MySQLi
        - function:
              - 'mysqli_connect'
              - 'mysqli_query'
          message: 'Verstoß gegen Clean Architecture: Datenbank-Operationen laufen ausschließlich über PDO im Infrastructure-Layer.'

        # 9. Verbot von nativen Env-Zugriffen
        - function:
              - 'getenv'
              - 'putenv'
          message: 'Verstoß gegen Clean Architecture: Nutze das ConfigInterface, anstatt Umgebungsvariablen direkt zu lesen.'

        # 10. ENDBOSS: Verbot von Zeit-Funktionen (Testbarkeit erzwingen)
        - function:
              - 'time'
              - 'date'
              - 'strtotime'
              - 'microtime'
              - 'sleep'
              - 'usleep'
              - 'uniqid'
          message: 'Verstoß gegen Clean Architecture: Nutze das ClockInterface anstelle von nativen Zeit-Funktionen, um den Code testbar zu halten.'
          allowIn:
              - src/SharedKernel/Infrastructure/*
              - src/Modules/*/Infrastructure/*
              - src/Application/View/TemplateRenderer.php
              - src/Bootstrap/*
              - public/*

    # =========================================================================
    # ARCHITEKTUR: VERBOTENE SUPERGLOBALS
    # =========================================================================
    disallowedSuperglobals:
        - superglobal: '$_GET'
          message: 'Verboten! Nutze stattdessen ServerRequest->get.'
          allowIn:
              - src/Application/Http/ServerRequest.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - public/index.php
        - superglobal: '$_POST'
          message: 'Verboten! Nutze stattdessen ServerRequest->post.'
          allowIn:
              - src/Application/Http/ServerRequest.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - public/index.php
        - superglobal: '$_FILES'
          message: 'Verboten! Nutze stattdessen ServerRequest->files.'
          allowIn:
              - src/Application/Http/ServerRequest.php
              - public/index.php
        - superglobal: '$_COOKIE'
          message: 'Verboten! Nutze stattdessen ServerRequest->cookie.'
          allowIn:
              - src/Application/Http/ServerRequest.php
              - public/index.php
        - superglobal: '$_SESSION'
          message: 'Verboten! Nutze stattdessen den gekapselten SessionManager.'
          allowIn:
              - src/Application/Session/SessionManager.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - src/Bootstrap/SystemBootstrapper.php
              - public/*
        - superglobal: '$_REQUEST'
          message: 'Verboten! Nutze stattdessen ServerRequest (get/post).'
          allowIn:
              - public/*
        - superglobal: '$_SERVER'
          message: 'Verboten! Nutze stattdessen ServerRequest->server oder IpResolverInterface.'
          allowIn:
              - src/Application/Http/ServerRequest.php
              - src/Application/Exception/GlobalExceptionHandler.php
              - src/Application/Middleware/SecurityHeadersMiddleware.php
              - src/Bootstrap/SystemBootstrapper.php
              - src/SharedKernel/Infrastructure/Config/Config.php
              - src/Modules/System/Infrastructure/System/ServerIpResolver.php
              - public/*
        - superglobal: '$_ENV'
          message: 'Verboten! Nutze stattdessen das ConfigInterface.'
