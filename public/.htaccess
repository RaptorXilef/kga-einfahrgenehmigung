# ##############################################################################
# ##                                                                          ##
# ##      KGA E-MANAGER .HTACCESS - FRONT-CONTROLLER & PERFORMANCE            ##
# ##                                                                          ##
# ##############################################################################

Options -Indexes -MultiViews +SymLinksIfOwnerMatch
DirectoryIndex index.php
AddDefaultCharset UTF-8
DefaultLanguage de-DE
ServerSignature Off

# Max Upload Size - 10MB
LimitRequestBody 10485760

# --- BLOCK 1: Security Hardening ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
    RewriteRule .* - [F]
</IfModule>

<FilesMatch "(^\.htaccess|php\.ini|licence\.txt|readme\.html|composer\.|package\.|^\.env|\.sql$|\.log$|\.bak$)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^.*/(assets|data|cache|vendor|node_modules|\.git)/.*\.php$ [NC]
    RewriteRule .* - [F,L]
</IfModule>

# --- BLOCK 2: MIME & Komprimierung ---
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType "application/json; charset=utf-8" .json
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# --- BLOCK 3: Aggressives Caching für statische Assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ttf|woff|woff2|ico)$">
        Header set Cache-Control "max-age=31536000, public, no-transform, immutable"
        Header set Timing-Allow-Origin "*"
    </FilesMatch>
    <FilesMatch "\.(css|js|json)$">
        Header set Cache-Control "max-age=2592000, public, no-transform"
    </FilesMatch>
</IfModule>

# --- BLOCK 4: URL-Hygiene & Front-Controller Routing ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 4.1: HTTPS & WWW-Zwang (SEO Canonical)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteCond %{HTTP_HOST} !\.local$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # 4.2: Trailing Slashes von Ordnern entfernen
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # 4.3: Globale .php Entfernung (301 Redirect für den Rest)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 4.4: THE FRONT CONTROLLER
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
